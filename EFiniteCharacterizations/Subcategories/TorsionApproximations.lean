module

public import EFiniteCharacterizations.Silting.Reduction.Bongartz
public import EFiniteCharacterizations.ScalarExtension.GroundFieldWitnesses
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.Mono

/-! # Functorial finiteness of classes generated by quotients -/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped ModuleCat.Algebra

universe u v

namespace EFiniteCharacterizations

variable {C : Type u} [Category.{v} C]

/-- Every object admits a left approximation by objects of this class. -/
def CovariantlyFinite (T : ObjectProperty C) : Prop :=
  ∀ X : C, ∃ (L : C) (i : X ⟶ L), T L ∧
    ∀ (Y : C), T Y → ∀ f : X ⟶ Y, ∃ g : L ⟶ Y, i ≫ g = f

/-- Every object admits a right approximation by objects of this class. -/
def ContravariantlyFinite (T : ObjectProperty C) : Prop :=
  ∀ X : C, ∃ (L : C) (p : L ⟶ X), T L ∧
    ∀ (Y : C), T Y → ∀ f : Y ⟶ X, ∃ g : Y ⟶ L, g ≫ p = f

/-- Every object admits a left and a right approximation by objects of this class. -/
def FunctoriallyFinite (T : ObjectProperty C) : Prop :=
  CovariantlyFinite T ∧ ContravariantlyFinite T

variable (k : Type u) [Field k] {R : Type u} [Ring R] [Algebra k R] [Module.Finite k R]
  [IsNoetherianRing R]

include k in
theorem functoriallyFinite_generatedBy (B : FGModuleCat.{u} R) : FunctoriallyFinite (IsGeneratedBy B) := by
  constructor
  · intro X
    obtain ⟨P, hP, p, hp⟩ := FGModuleCat.exists_projective_epi X
    have := finiteModuleHom_isFinite k P B
    let n := Module.finrank k (P ⟶ B)
    let b := Module.finBasis k (P ⟶ B)
    let A : Fin n → FGModuleCat.{u} R := fun _ ↦ B
    let a : P ⟶ ⨁ A := biproduct.lift b
    let D := pushout p a
    refine ⟨D, pushout.inl p a, ⟨n, pushout.inr p a, inferInstance⟩, ?_⟩
    intro Y hY f
    obtain ⟨m, q, hq⟩ := hY
    obtain ⟨t, ht⟩ := FGModuleCat.exists_lift_of_projective q (p ≫ f)
    let F : Fin m → FGModuleCat.{u} R := fun _ ↦ B
    have factor (r : P ⟶ B) : ∃ g : (⨁ A) ⟶ B, a ≫ g = r := by
      refine ⟨∑ j, b.repr r j • biproduct.π A j, ?_⟩
      simp [a, Preadditive.comp_sum, Linear.comp_smul, b.sum_repr]
    choose g hg using fun j : Fin m ↦ factor (t ≫ biproduct.π F j)
    have h : a ≫ biproduct.lift g = t := by
      apply biproduct.hom_ext
      intro j
      rw [Category.assoc, biproduct.lift_π, hg]
    have comm : p ≫ f = a ≫ biproduct.lift g ≫ q := by rw [← Category.assoc, h, ht]
    exact ⟨pushout.desc f _ comm, pushout.inl_desc ..⟩
  · intro X
    obtain ⟨T, i, hi, hT, hkill⟩ := TwoTerm.exists_generated_subobject_killing_hom k B X
    refine ⟨T, i, hT, ?_⟩
    intro Y hY f
    have hz : f ≫ cokernel.π i = 0 :=
      hY.hom_eq_zero _ (fun g ↦ by rw [← Category.assoc]; exact hkill _)
    exact ⟨Abelian.monoLift i f hz, Abelian.monoLift_comp i f hz⟩

include k in
/-- A torsion class given as a left perpendicular is functorially finite
exactly when it consists of the quotients of finite sums of a single module. -/
theorem functoriallyFinite_leftOrthogonal_iff (F : ObjectProperty (FGModuleCat.{u} R)) :
    FunctoriallyFinite (leftHomOrthogonal F) ↔
      ∃ B : FGModuleCat.{u} R, leftHomOrthogonal F = IsGeneratedBy B := by
  refine ⟨fun h ↦ ?_, fun ⟨B, he⟩ ↦ he ▸ functoriallyFinite_generatedBy k B⟩
  obtain ⟨B, i, hB, hfac⟩ := h.1 (FGModuleCat.of R R)
  refine ⟨B, funext fun M ↦ propext ⟨fun hM ↦ ?_, fun hM Y hY f ↦ ?_⟩⟩
  · obtain ⟨T, j, hj, hT, hkill⟩ := TwoTerm.exists_generated_subobject_killing_hom k B M
    have hzero : cokernel.π j = 0 := by
      apply FGModuleCat.hom_ext
      ext x
      let a : FGModuleCat.of R R ⟶ M := FGModuleCat.ofHom (LinearMap.toSpanSingleton R M x)
      obtain ⟨g, hg⟩ := hfac M hM a
      have h : a ≫ cokernel.π j = 0 := by rw [← hg, Category.assoc, hkill g, comp_zero]
      have hh := congrArg (fun b : FGModuleCat.of R R ⟶ cokernel j ↦ b.hom.hom 1) h
      change (cokernel.π j).hom.hom (LinearMap.toSpanSingleton R M x 1) = 0 at hh
      rwa [LinearMap.toSpanSingleton_apply_one] at hh
    have := Abelian.epi_of_cokernel_π_eq_zero j hzero
    exact hT.of_epi j
  · exact hM.hom_eq_zero f fun g ↦ hB Y hY (g ≫ f)

namespace TwoTerm

include k in
theorem functoriallyFinite_weak_torsion (P : TwoTerm R) (hP : P.IsPresilting) :
    FunctoriallyFinite (fun X ↦ Function.Surjective (P.precompose X)) := by
  obtain ⟨Q, _, _, hQ⟩ := P.exists_bongartz_complement k hP
  rw [show (fun X ↦ Function.Surjective (P.precompose X)) = IsGeneratedBy (cokernel Q.differential)
    from funext fun X ↦ propext (hQ X)]
  exact functoriallyFinite_generatedBy k _

end TwoTerm

/-- The weak numerical torsion class at an integral weight. -/
def Weight.weakTorsionClass [Abelian C] (θ : Weight C) : ObjectProperty C :=
  fun X ↦ ∀ {Q : C} (q : X ⟶ Q) [Epi q], 0 ≤ θ.eval Q

private noncomputable abbrev dim (M : FGModuleCat.{u} R) := Module.finrank k (M.obj : Type u)

include k in
/-- A module in the weak numerical torsion class has a largest semistable
quotient through which all its maps to semistable modules factor. -/
theorem exists_semistable_quotient_approximation (θ : Weight (FGModuleCat.{u} R))
    (B : FGModuleCat.{u} R) (hB : θ.weakTorsionClass B) :
    ∃ (G : FGModuleCat.{u} R) (p : B ⟶ G), Epi p ∧ θ.IsSemistable G ∧
      ∀ (S : FGModuleCat.{u} R), θ.IsSemistable S → ∀ f : B ⟶ S, ∃ g : G ⟶ S, p ≫ g = f := by
  classical
  let A (n : ℕ) := ∃ (G : FGModuleCat.{u} R) (p : B ⟶ G), Epi p ∧ θ.IsSemistable G ∧ dim k G = n
  let Z := (ProjectiveClass.zeroProjective R).val
  let q : B ⟶ Z := 0
  have hZ : IsZero Z := ProjectiveClass.zeroProjective_isZero
  have : Epi q := ⟨fun f g _ ↦ hZ.eq_of_src f g⟩
  have hinit : A (dim k Z) := ⟨Z, q, inferInstance, (Weight.isSemistable_iff_quotients Z).2
    ⟨θ.eval_isZero hZ, fun f _ ↦ hB (q ≫ f)⟩, rfl⟩
  obtain ⟨G, p, hp, hG, hd⟩ := Nat.findGreatest_spec (groundFinrank_le_of_epi k q) hinit
    (P := A)
  refine ⟨G, p, hp, hG, fun S hS f ↦ ?_⟩
  let t := biprod.lift p f
  let I := Abelian.image t
  let e := Abelian.factorThruImage t
  let i := Abelian.image.ι t
  have ht := hG.biprod hS
  have hI : θ.IsSemistable I := ht.of_mono_of_eval_zero i (le_antisymm (ht.2 i) (hB e))
  let r := i ≫ biprod.fst
  have hr : e ≫ r = p := by rw [show e ≫ r = (e ≫ i) ≫ biprod.fst from (Category.assoc ..).symm,
    Abelian.image.fac, biprod.lift_fst]
  have : Epi r := epi_of_epi_fac hr
  have hle : dim k I ≤ dim k G := hd ▸ Nat.le_findGreatest (groundFinrank_le_of_epi k e)
    (show A (dim k I) from ⟨_, e, inferInstance, hI, rfl⟩)
  have : Module.Finite k (I.obj : Type u) := Module.Finite.trans R _
  have : Module.Finite k (G.obj : Type u) := Module.Finite.trans R _
  have heq := le_antisymm hle (groundFinrank_le_of_epi k r)
  have hsur := (FGModuleCat.epi_iff_surjective r).1 inferInstance
  have : IsIso r := (FGModuleCat.isIso_iff_bijective r).2
    ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank heq (f := r.hom.hom.restrictScalars k)).2 hsur, hsur⟩
  refine ⟨inv r ≫ i ≫ biprod.snd, ?_⟩
  rw [← hr, Category.assoc, IsIso.hom_inv_id_assoc, ← Category.assoc, Abelian.image.fac, biprod.lift_snd]

include k in
theorem finite_stableClasses_of_regular_approximation {θ : Weight (FGModuleCat.{u} R)}
    {G : FGModuleCat.{u} R} (hG : θ.IsSemistable G) (a : FGModuleCat.of R R ⟶ G)
    (hfac : ∀ S, θ.IsStable S → ∀ f : FGModuleCat.of R R ⟶ S, ∃ c, a ≫ c = f) :
    (stableClasses θ).Finite := by
  apply (finite_stableQuotientClasses k θ G hG).subset
  intro x hx
  let S := (fromSkeleton (FGModuleCat.{u} R)).obj x
  have hs : θ.IsStable S := hx
  have hnon : Nontrivial (S.obj : Type u) := not_subsingleton_iff_nontrivial.mp
    (hs.1 ∘ (FGModuleCat.isZero_iff_subsingleton S).2)
  obtain ⟨s, hne⟩ := exists_ne (0 : S.obj)
  let f : FGModuleCat.of R R ⟶ S := FGModuleCat.ofHom (LinearMap.toSpanSingleton R S s)
  obtain ⟨c, hc⟩ := hfac S hs f
  refine ⟨hx, c, fun hz ↦ hne ?_⟩
  have hf : f = 0 := by rw [← hc, hz, comp_zero]
  have hv := congrArg (fun u : FGModuleCat.of R R ⟶ S ↦ u.hom.hom 1) hf
  exact (LinearMap.toSpanSingleton_apply_one R _ s).symm.trans hv

/-- A presilting weight has a functorially finite weak torsion class. -/
theorem TwoTerm.functoriallyFinite_weakTorsionClass (P : TwoTerm R) (hp : P.IsPresilting) :
    FunctoriallyFinite (P.eulerWeight k).weakTorsionClass := by
  have he : (P.eulerWeight k).weakTorsionClass = (fun X ↦ Function.Surjective (P.precompose X)) := by
    funext X
    exact propext ((P.nonneg_eulerWeight_all_quotients_iff k hp X).trans
      (P.surjective_precompose_iff_no_hom_nakayamaKernel k X).symm)
  rw [he]
  exact P.functoriallyFinite_weak_torsion k hp

include k in
theorem isEFinite_iff_functoriallyFinite_weakTorsion [IsArtinianRing R] :
    IsEFinite R ↔ ∀ g : ProjectiveClass R, FunctoriallyFinite ((projectiveClassWeight k g).weakTorsionClass) := by
  refine ⟨fun h g ↦ ?_, fun h ↦ ?_⟩
  · obtain ⟨P, hp, rfl⟩ := h g
    rw [P.projectiveClassWeight_eq_eulerWeight k]
    exact P.functoriallyFinite_weakTorsionClass k hp
  · apply (isEFinite_iff_stableFiniteAtAllIntegralWeights_allFields k).2
    intro g
    let θ := projectiveClassWeight (R := R) k g
    obtain ⟨B, a, hB, ha⟩ := (h g).1 (FGModuleCat.of R R)
    obtain ⟨G, p, _, hG, hfac⟩ := exists_semistable_quotient_approximation k θ B hB
    apply finite_stableClasses_of_regular_approximation k hG (a ≫ p)
    intro S hs f
    obtain ⟨b, hb⟩ := ha S ((Weight.isSemistable_iff_quotients S).1 hs.isSemistable).2 f
    obtain ⟨c, hc⟩ := hfac S hs.isSemistable b
    exact ⟨c, by rw [Category.assoc, hc, hb]⟩

include k in
theorem functoriallyFinite_strictTorsion_of_isEFinite (h : IsEFinite R) (g : ProjectiveClass R) :
    FunctoriallyFinite (fun X ↦ ∀ {Q : FGModuleCat.{u} R} (q : X ⟶ Q) [Epi q],
      ¬ IsZero Q → 0 < (projectiveClassWeight k g).eval Q) := by
  obtain ⟨P, hp, rfl⟩ := h g
  rw [P.projectiveClassWeight_eq_eulerWeight k]
  convert functoriallyFinite_generatedBy k (cokernel P.differential) using 1
  exact funext fun M ↦ propext (P.pos_eulerWeight_nonzero_quotients_iff k hp M)

end EFiniteCharacterizations
