module

public import EFiniteCharacterizations.LargeModules.GenericGrain
public import EFiniteCharacterizations.Subcategories.TorsionPairs
public import EFiniteCharacterizations.Subcategories.TorsionApproximations

/-! # The finite module torsion pair associated to a rigid injective copresentation -/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
universe u
namespace EFiniteCharacterizations

variable {R : Type u} [Ring R] [IsNoetherianRing R] [IsArtinianRing R]

def perpendicularToModule (N : ModuleCat.{u} R) : ObjectProperty (FGModuleCat.{u} R) :=
  fun X ↦ ∀ f : X.obj ⟶ N, f = 0

def cogeneratedByModule (N : ModuleCat.{u} R) : ObjectProperty (FGModuleCat.{u} R) :=
  fun X ↦ ∃ (n : ℕ) (f : X →ₗ[R] (Fin n → N)), Function.Injective f

/-- If maps into N extend across short exact sequences whose quotient is
cogenerated by N, the left perpendicular and the cogenerated modules form a torsion pair. -/
theorem torsionPair_of_cogenerated_extensions (N : ModuleCat.{u} R)
    (hext : ∀ (S : ShortComplex (FGModuleCat.{u} R)), S.ShortExact → cogeneratedByModule N S.X₃ →
      ∀ f : S.X₁.obj ⟶ N, ∃ b : S.X₂.obj ⟶ N, S.f.hom ≫ b = f) :
    IsTorsionPair (perpendicularToModule N) (cogeneratedByModule N) := by
  classical
  constructor
  · rintro X Y f ht ⟨n,t,hi⟩
    apply FGModuleCat.hom_ext
    ext x
    apply hi
    funext i
    have he := ht (ModuleCat.ofHom (((LinearMap.proj i).comp t).comp f.hom.hom))
    exact DFunLike.congr_fun (congrArg ModuleCat.Hom.hom he) x |>.trans (by simp)
  · intro X
    let A := X.obj.carrier
    let eval : A →ₗ[R] ((A →ₗ[R] N) → N) := LinearMap.pi id
    let U := eval.ker
    let L := FGModuleCat.of R U
    let Q := FGModuleCat.of R (A ⧸ U)
    let i : L ⟶ X := FGModuleCat.ofHom U.subtype
    let p : X ⟶ Q := FGModuleCat.ofHom U.mkQ
    obtain ⟨w,hs⟩ := shortExact_of_range_ker i p Subtype.val_injective U.mkQ_surjective
      (by change U.subtype.range = U.mkQ.ker; simp)
    let g : Q.obj.carrier →ₗ[R] ((A →ₗ[R] N) → N) := eval.ker.liftQ eval le_rfl
    have hg : Function.Injective g := LinearMap.ker_eq_bot.mp (Submodule.ker_liftQ_eq_bot _ _ _ le_rfl)
    obtain ⟨n,a,ha⟩ := finite_coordinates_of_product_embedding (X := Q.obj) (N := N) g hg
    let t := LinearMap.pi (fun j ↦ (LinearMap.proj (a j)).comp g)
    refine ⟨L,Q,i,p,w,?_,⟨n,t,ha⟩,hs⟩
    intro f
    let S := ShortComplex.mk i p w
    obtain ⟨b,hb⟩ := hext S hs ⟨n,t,ha⟩ f
    apply ModuleCat.hom_ext
    ext x
    change f.hom x = 0
    rw [← hb]
    exact congrFun (show eval x.val = 0 from x.property) b.hom

theorem rigidKernel_torsionPair {I J : ModuleCat.{u} R} [Injective I] [Injective J] (d : I ⟶ J)
    (rigid : ∀ b : I ⟶ J, ∃ (a : I ⟶ I) (c : J ⟶ J), b = a ≫ d + d ≫ c) :
    IsTorsionPair (perpendicularToModule (kernel d)) (cogeneratedByModule (kernel d)) := by
  apply torsionPair_of_cogenerated_extensions
  rintro S hs ⟨n,t,ht⟩ f
  let F := forget₂ (FGModuleCat.{u} R) (ModuleCat.{u} R)
  exact extends_to_rigid_kernel d rigid (S.map F) (hs.map_of_exact F) t ht f

/-- The Euler signs on the two halves identify the copresentation torsion pair
with the numerical torsion pair at the given weight. -/
theorem rigidKernel_numerical_pair {I J : ModuleCat.{u} R} [Injective I] [Injective J]
    (d : I ⟶ J) (rigid : ∀ b : I ⟶ J, ∃ (a : I ⟶ I) (c : J ⟶ J), b = a ≫ d + d ≫ c)
    (θ : Weight (FGModuleCat.{u} R))
    (pos : ∀ X, perpendicularToModule (kernel d) X → 0 ≤ θ.eval X)
    (neg : ∀ X, cogeneratedByModule (kernel d) X → ¬ IsZero X → θ.eval X < 0) :
    perpendicularToModule (kernel d) = θ.weakTorsionClass ∧
      cogeneratedByModule (kernel d) = (fun X ↦ ∀ {U : FGModuleCat.{u} R} (i : U ⟶ X) [Mono i],
        ¬ IsZero U → θ.eval U < 0) := by
  have pair := rigidKernel_torsionPair d rigid
  have quot {X Y : FGModuleCat.{u} R} (p : X ⟶ Y) [Epi p] (h : perpendicularToModule (kernel d) X) :
      perpendicularToModule (kernel d) Y := by
    have : Epi p.hom := (ModuleCat.epi_iff_surjective _).2 ((FGModuleCat.epi_iff_surjective p).1 inferInstance)
    exact fun f ↦ (cancel_epi p.hom).1 ((h (p.hom ≫ f)).trans comp_zero.symm)
  have sub {X Y : FGModuleCat.{u} R} (i : X ⟶ Y) [Mono i] (h : cogeneratedByModule (kernel d) Y) :
      cogeneratedByModule (kernel d) X := by
    obtain ⟨n,f,hf⟩ := h
    exact ⟨n,f.comp i.hom.hom,hf.comp ((FGModuleCat.mono_iff_injective i).1 inferInstance)⟩
  constructor <;> funext X <;> apply propext
  · constructor
    · exact fun h _ p _ ↦ pos _ (quot p h)
    · intro h
      obtain ⟨L,Q,i,p,w,hL,hQ,hs⟩ := pair.2 X
      have := hs.epi_g
      have hz : IsZero Q := by
        by_contra hn
        exact (neg Q hQ hn).not_ge (h p)
      have := hs.isIso_f_iff.2 hz
      exact quot i hL
  · constructor
    · exact fun h _ i _ hn ↦ neg _ (sub i h) hn
    · intro h
      obtain ⟨L,Q,i,p,w,hL,hQ,hs⟩ := pair.2 X
      have := hs.mono_f
      have hz : IsZero L := by
        by_contra hn
        exact (h i hn).not_ge (pos _ hL)
      have := hs.isIso_g_iff.2 hz
      exact sub p hQ

/-- An Euler dimension formula identifies both halves of the rigid kernel torsion pair.
The division-ring actions are needed only on the two Hom spaces. -/
theorem rigidKernel_pair_of_euler_formula {I J : ModuleCat.{u} R} [Injective I] [Injective J]
    (d : I ⟶ J) (rigid : ∀ b : I ⟶ J, ∃ (a : I ⟶ I) (c : J ⟶ J), b = a ≫ d + d ≫ c)
    (θ : Weight (FGModuleCat.{u} R)) (K : Type*) [DivisionRing K]
    [∀ X : FGModuleCat.{u} R, Module K (X.obj ⟶ I)] [∀ X : FGModuleCat.{u} R, Module K (X.obj ⟶ J)]
    [∀ X : FGModuleCat.{u} R, Module.Finite K (X.obj ⟶ I)]
    [∀ X : FGModuleCat.{u} R, Module.Finite K (X.obj ⟶ J)]
    (D : ∀ X : FGModuleCat.{u} R, (X.obj ⟶ I) →ₗ[K] (X.obj ⟶ J))
    (post : ∀ X f, D X f = f ≫ d)
    (euler : ∀ X, θ.eval X = (Module.finrank K (X.obj ⟶ J) : ℤ) - Module.finrank K (X.obj ⟶ I)) :
    perpendicularToModule (kernel d) = θ.weakTorsionClass ∧
      cogeneratedByModule (kernel d) = (fun X ↦ ∀ {U : FGModuleCat.{u} R} (i : U ⟶ X) [Mono i],
        ¬ IsZero U → θ.eval U < 0) := by
  apply rigidKernel_numerical_pair d rigid θ
  · intro X h
    have hinj : Function.Injective (D X) := LinearMap.ker_eq_bot.mp (LinearMap.ker_eq_bot'.2 (by
      intro f hf
      rw [post] at hf
      have hz := h (kernel.lift d f hf)
      simpa [hz] using (kernel.lift_ι d f hf).symm))
    have hle := LinearMap.finrank_le_finrank_of_injective hinj
    rw [euler]
    omega
  · rintro X ⟨n,t,ht⟩ hn
    have surj : Function.Surjective (D X) := by
      intro f
      obtain ⟨a,ha⟩ := cogenerated_lifts_of_rigid d rigid t ht f
      exact ⟨a,(post X a).trans ha⟩
    have hbad : ¬ Function.Injective (D X) := by
      intro hi
      have hzero (i : Fin n) : ModuleCat.ofHom ((LinearMap.proj i).comp t) = 0 := by
        let f : X.obj ⟶ kernel d := ModuleCat.ofHom ((LinearMap.proj i).comp t)
        apply (cancel_mono (kernel.ι d)).1
        change f ≫ kernel.ι d = 0 ≫ kernel.ι d
        apply hi
        simp [post]
      apply hn
      apply (FGModuleCat.isZero_iff_subsingleton _).2
      exact ⟨fun x y ↦ ht (funext fun i ↦
        (DFunLike.congr_fun (congrArg ModuleCat.Hom.hom (hzero i)) x).trans
          (DFunLike.congr_fun (congrArg ModuleCat.Hom.hom (hzero i)) y).symm)⟩
    have hle := LinearMap.finrank_le_finrank_of_surjective surj
    have hne : Module.finrank K (X.obj ⟶ I) ≠ Module.finrank K (X.obj ⟶ J) := by
      intro h
      exact hbad ((LinearMap.injective_iff_surjective_of_finrank_eq_finrank h).2 surj)
    rw [euler]
    omega

open scoped ModuleCat.Algebra
omit [IsNoetherianRing R] in
/-- An embedding of N in a product of copies of M transfers finite
cogeneration tests, since finitely many coordinates separate an Artinian domain. -/
theorem cogeneratedByModule_le_of_product_embedding {N M : ModuleCat.{u} R} {ι : Type u}
    (g : N →ₗ[R] (ι → M)) (hg : Function.Injective g) :
    cogeneratedByModule N ≤ cogeneratedByModule M := by
  rintro X ⟨n,f,hf⟩
  let t := LinearMap.pi (fun a : Fin n × ι ↦
    (LinearMap.proj a.2).comp (g.comp ((LinearMap.proj a.1).comp f)))
  have ht : Function.Injective t := by
    intro x y h
    exact hf (funext (fun j ↦ hg (funext (fun i ↦ congrFun h (j,i)))))
  obtain ⟨m,a,ha⟩ := finite_coordinates_of_product_embedding (X := X.obj) (N := M) t ht
  exact ⟨m,LinearMap.pi (fun j ↦ (LinearMap.proj (a j)).comp t),ha⟩

omit [IsNoetherianRing R] [IsArtinianRing R] in
theorem perp_le_of_product_embedding {M N : ModuleCat.{u} R} {ι : Type u}
    (g : N →ₗ[R] (ι → M)) (hg : Function.Injective g) :
    perpendicularToModule M ≤ perpendicularToModule N := by
  intro X h f
  apply ModuleCat.hom_ext
  ext x
  apply hg
  funext i
  have hz := h (ModuleCat.ofHom ((LinearMap.proj i).comp (g.comp f.hom)))
  exact (DFunLike.congr_fun (congrArg ModuleCat.Hom.hom hz) x).trans (by simp)

open scoped DirectSum in
omit [IsNoetherianRing R] [IsArtinianRing R] in
/-- Given a decomposition into copies of finitely many indecomposables, an
endofinite module satisfying the splitting test either has the perpendicular
of a finite module or has a generic grain as a summand. -/
private theorem finite_product_embeddings_or_generic_grain (k : Type u) [Field k] [Algebra k R]
    (N : ModuleCat.{u} R) (he : IsEndofinite N) (hs : SplitsOnCogeneratedModules k N)
    {ι J : Type u} [Fintype J] (label : ι → J) (hl : Function.Surjective label)
    (D : J → ModuleCat.{u} R) (hd : ∀ j, Indecomposable (D j))
    (e : N ≃ₗ[R] ⨁ i, D (label i)) :
    (∃ M : FGModuleCat.{u} R, (∃ g : N →ₗ[R] (ι → M), Function.Injective g) ∧
      (∃ f : M →ₗ[R] (J → N), Function.Injective f)) ∨
      ∃ G : ModuleCat.{u} R, Nonempty (Retract G N) ∧ IsGenericGrain k G := by
  classical
  let A (i : ι) := (D (label i) : Type u)
  have ret (j : J) : Nonempty (Retract (D j) N) := by
    obtain ⟨i,rfl⟩ := hl j
    refine ⟨⟨ModuleCat.ofHom (e.symm.toLinearMap.comp (DirectSum.lof R ι A i)),
      ModuleCat.ofHom ((DirectSum.component R ι A i).comp e.toLinearMap),?_⟩⟩
    ext x
    change DirectSum.component R ι A i (e (e.symm (DirectSum.lof R ι A i x))) = x
    simp
  by_cases hf : ∀ j, Module.Finite k (D j)
  · left
    have (j : J) : Module.Finite R (D j) := Module.Finite.of_restrictScalars_finite k R _
    let M := FGModuleCat.of R (∀ j, D j)
    refine ⟨M,?_,?_⟩
    · let coord (i : ι) := (LinearMap.single R (fun j ↦ (D j : Type u)) (label i)).comp
        ((DirectSum.component R ι A i).comp e.toLinearMap)
      refine ⟨LinearMap.pi coord,?_⟩
      intro x y hh
      apply e.injective
      ext i
      have h := congrFun (congrFun hh i) (label i)
      change DirectSum.component R ι A i (e x) = DirectSum.component R ι A i (e y)
      simpa [coord,LinearMap.single_apply] using h
    · let r (j : J) := (ret j).some
      let coord (j : J) := (r j).i.hom.comp (LinearMap.proj j : (∀ j, D j) →ₗ[R] D j)
      refine ⟨LinearMap.pi coord,?_⟩
      intro x y hh
      funext j
      have h := congrArg (r j).r.hom (congrFun hh j)
      have eq (z : D j) := DFunLike.congr_fun (congrArg ModuleCat.Hom.hom (r j).retract) z
      exact (eq (x j)).symm.trans (h.trans (eq (y j)))
  · push Not at hf
    obtain ⟨j,hj⟩ := hf
    obtain ⟨r⟩ := ret j
    exact Or.inr ⟨D j,⟨r⟩,isGenericGrain_of_retract k r he hs hj (hd j)⟩

open scoped DirectSum in
omit [IsNoetherianRing R] [IsArtinianRing R] in
/-- The left perpendicular is represented by a finite module unless N has a generic grain summand. -/
theorem finite_perpendicular_or_generic_grain (k : Type u) [Field k] [Algebra k R]
    (N : ModuleCat.{u} R) (he : IsEndofinite N) (hs : SplitsOnCogeneratedModules k N)
    {ι J : Type u} [Fintype J] (label : ι → J) (hl : Function.Surjective label)
    (D : J → ModuleCat.{u} R) (hd : ∀ j, Indecomposable (D j))
    (e : N ≃ₗ[R] ⨁ i, D (label i)) :
    (∃ M : FGModuleCat.{u} R, perpendicularToModule N = perpendicularToModule M.obj) ∨
      ∃ G : ModuleCat.{u} R, Nonempty (Retract G N) ∧ IsGenericGrain k G :=
  (finite_product_embeddings_or_generic_grain k N he hs label hl D hd e).imp_left
    (fun ⟨M,⟨g,hg⟩,⟨f,hf⟩⟩ ↦ ⟨M,le_antisymm (perp_le_of_product_embedding f hf)
      (perp_le_of_product_embedding g hg)⟩)

open scoped DirectSum in
omit [IsNoetherianRing R] in
/-- In the finite alternative, a single finite module realizes both halves of the pair. -/
theorem finite_cogenerator_or_generic_grain (k : Type u) [Field k] [Algebra k R]
    (N : ModuleCat.{u} R) (he : IsEndofinite N) (hs : SplitsOnCogeneratedModules k N)
    {ι J : Type u} [Fintype J] (label : ι → J) (hl : Function.Surjective label)
    (D : J → ModuleCat.{u} R) (hd : ∀ j, Indecomposable (D j))
    (e : N ≃ₗ[R] ⨁ i, D (label i)) :
    (∃ M : FGModuleCat.{u} R, perpendicularToModule N = perpendicularToModule M.obj ∧
      cogeneratedByModule N = cogeneratedByModule M.obj) ∨
      ∃ G : ModuleCat.{u} R, Nonempty (Retract G N) ∧ IsGenericGrain k G :=
  (finite_product_embeddings_or_generic_grain k N he hs label hl D hd e).imp_left
    (fun ⟨M,⟨g,hg⟩,⟨f,hf⟩⟩ ↦ ⟨M,le_antisymm (perp_le_of_product_embedding f hf)
      (perp_le_of_product_embedding g hg),le_antisymm (cogeneratedByModule_le_of_product_embedding g hg)
      (cogeneratedByModule_le_of_product_embedding f hf)⟩)

end EFiniteCharacterizations
