module

public import EFiniteCharacterizations.Modules.ProjectiveBiproducts
public import EFiniteCharacterizations.Silting.Fans.CoveredWeights

/-! # The strict quotient test at a presilting weight -/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace EFiniteCharacterizations

variable {R : Type u} [Ring R]

/-- The modules in `Fac X` are quotients of finite direct sums of copies of `X`. -/
def IsGeneratedBy (X M : FGModuleCat.{u} R) : Prop :=
  ∃ (n : ℕ) (q : (⨁ fun _ : Fin n ↦ X) ⟶ M), Epi q

theorem IsGeneratedBy.of_epi {X M N : FGModuleCat.{u} R} (h : IsGeneratedBy X M)
    (q : M ⟶ N) [Epi q] : IsGeneratedBy X N := by
  obtain ⟨n, p, hp⟩ := h
  exact ⟨n, p ≫ q, inferInstance⟩

theorem IsGeneratedBy.hom_eq_zero {X M N : FGModuleCat.{u} R}
    (h : IsGeneratedBy X M) (f : M ⟶ N) (hf : ∀ a : X ⟶ M, a ≫ f = 0) : f = 0 := by
  obtain ⟨n, q, hq⟩ := h
  apply (cancel_epi q).1
  apply biproduct.hom_ext'
  intro i
  rw [comp_zero, comp_zero, ← Category.assoc]
  exact hf _

theorem IsGeneratedBy.exists_nonzero_hom {X M : FGModuleCat.{u} R}
    (h : IsGeneratedBy X M) (hM : ¬ IsZero M) : ∃ f : X ⟶ M, f ≠ 0 := by
  classical
  by_contra! hn
  exact hM ((IsZero.iff_id_eq_zero _).2 (h.hom_eq_zero (𝟙 M) (by simpa using hn)))

namespace TwoTerm

/-- Surjectivity of the Hom differential into a single generator propagates
to every module it generates. -/
theorem surjective_precompose_of_generatedBy (P : TwoTerm R) {X M : FGModuleCat.{u} R}
    (hX : Function.Surjective (P.precompose X)) (hM : IsGeneratedBy X M) :
    Function.Surjective (P.precompose M) := by
  let _ := P.projective_source
  obtain ⟨n, q, hq⟩ := hM
  let A : Fin n → FGModuleCat.{u} R := fun _ ↦ X
  change (⨁ A) ⟶ M at q
  intro f
  obtain ⟨g, hg⟩ := FGModuleCat.exists_lift_of_projective q f
  choose b hb using fun i : Fin n ↦ hX (g ≫ biproduct.π A i)
  have hcomp : P.differential ≫ biproduct.lift b = g := by
    apply biproduct.hom_ext
    intro i
    rw [Category.assoc, biproduct.lift_π]
    exact hb i
  refine ⟨biproduct.lift b ≫ q, ?_⟩
  change P.differential ≫ biproduct.lift b ≫ q = f
  rw [← Category.assoc, hcomp, hg]

/-- The Hom map from the cokernel lifts along an epimorphism if the Hom
differential is surjective into its kernel. -/
theorem exists_cokernel_hom_lift [IsNoetherianRing R] (P : TwoTerm R) {T M N : FGModuleCat.{u} R}
    {i : T ⟶ M} {q : M ⟶ N} [Epi q] (hi : i ≫ q = 0) (he : (ShortComplex.mk i q hi).Exact)
    (hT : Function.Surjective (P.precompose T)) (f : cokernel P.differential ⟶ N) :
    ∃ g : cokernel P.differential ⟶ M, g ≫ q = f := by
  let _ := P.projective_target
  let _ := P.projective_source
  obtain ⟨a, ha⟩ := FGModuleCat.exists_lift_of_projective q (cokernel.π P.differential ≫ f)
  have haz : (P.differential ≫ a) ≫ q = 0 := by
    rw [Category.assoc, ha, ← Category.assoc, cokernel.condition, zero_comp]
  obtain ⟨b, hb⟩ := exists_lift_of_exact hi he _ haz
  obtain ⟨c, hc⟩ := hT b
  change P.differential ≫ c = b at hc
  have hz : P.differential ≫ (a - c ≫ i) = 0 := by
    rw [Preadditive.comp_sub, ← Category.assoc, hc, hb, sub_self]
  refine ⟨cokernel.desc P.differential (a - c ≫ i) hz, ?_⟩
  apply (cancel_epi (cokernel.π P.differential)).1
  rw [← Category.assoc, cokernel.π_desc, Preadditive.sub_comp, Category.assoc, hi, comp_zero, sub_zero, ha]

variable (k : Type u) [Field k] [Algebra k R] [Module.Finite k R] [IsNoetherianRing R]

include k in
/-- The trace of a module is generated by a finite sum of copies of that
module and the trace quotient kills all maps from it. -/
theorem exists_generated_subobject_killing_hom (X M : FGModuleCat.{u} R) :
    ∃ (T : FGModuleCat.{u} R) (i : T ⟶ M), Mono i ∧ IsGeneratedBy X T ∧
      ∀ f : X ⟶ M, f ≫ cokernel.π i = 0 := by
  have := finiteModuleHom_isFinite k X M
  let b := Module.finBasis k (X ⟶ M)
  let A : Fin (Module.finrank k (X ⟶ M)) → FGModuleCat.{u} R := fun _ ↦ X
  let a : (⨁ A) ⟶ M := biproduct.desc b
  let i := Abelian.image.ι a
  let j := Abelian.factorThruImage a
  refine ⟨Abelian.image a, i, inferInstance, ⟨_, j, inferInstance⟩, ?_⟩
  let q := cokernel.π i
  have hq : a ≫ q = 0 := calc
    a ≫ q = (j ≫ i) ≫ q := congrArg (fun g : (⨁ A) ⟶ M ↦ g ≫ q) (Abelian.image.fac a).symm
    _ = 0 := by rw [Category.assoc, cokernel.condition, comp_zero]
  have hs : Linear.rightComp k X q = 0 := by
    apply b.ext
    intro l
    have hbl : biproduct.ι A l ≫ a = b l := biproduct.ι_desc _ _
    change b l ≫ q = 0
    rw [← hbl, Category.assoc, hq, comp_zero]
  intro f
  exact DFunLike.congr_fun hs f

include k in
/-- The trace of a presilting cokernel has quotient in the right
perpendicular of that cokernel. -/
theorem exists_generated_subobject_cokernel_hom_zero (P : TwoTerm R) (hP : P.IsPresilting)
    (M : FGModuleCat.{u} R) :
    ∃ (T : FGModuleCat.{u} R) (i : T ⟶ M), Mono i ∧ IsGeneratedBy (cokernel P.differential) T ∧
      Subsingleton (cokernel P.differential ⟶ cokernel i) := by
  obtain ⟨T, i, hi, hT, hkill⟩ := exists_generated_subobject_killing_hom k (cokernel P.differential) M
  have hs := (surjective_boundary_iff_surjective_precompose P P).1 hP
  have hzero (f : cokernel P.differential ⟶ cokernel i) : f = 0 := by
    obtain ⟨g, hg⟩ := P.exists_cokernel_hom_lift (cokernel.condition i) (ShortComplex.exact_cokernel i)
      (P.surjective_precompose_of_generatedBy hs hT) f
    exact hg.symm.trans (hkill g)
  exact ⟨T, i, hi, hT, ⟨fun f g ↦ (hzero f).trans (hzero g).symm⟩⟩

include k in
/-- The strict quotient inequalities for the Euler weight of a presilting
complex hold precisely on the modules generated by its cokernel. -/
theorem pos_eulerWeight_nonzero_quotients_iff (P : TwoTerm R)
    (hP : P.IsPresilting) (M : FGModuleCat.{u} R) :
    (∀ {N : FGModuleCat.{u} R} (q : M ⟶ N) [Epi q], ¬ IsZero N → 0 < (P.eulerWeight k).eval N) ↔
      IsGeneratedBy (cokernel P.differential) M := by
  let X := cokernel P.differential
  have hs : Function.Surjective (P.precompose X) :=
    (surjective_boundary_iff_surjective_precompose P P).1 hP
  constructor
  · intro h
    obtain ⟨T, i, _, hT, hzero⟩ := P.exists_generated_subobject_cokernel_hom_zero k hP M
    let q := cokernel.π i
    have hz : IsZero (cokernel i) := by
      by_contra hn
      have hp := h q hn
      have hdim := (homFinrank_eq_zero_iff k X (cokernel i)).2 (fun f ↦ hzero.elim f 0)
      rw [P.eulerWeight_eq_perpendicular_difference k, hdim] at hp
      omega
    have : Epi i := Abelian.epi_of_cokernel_π_eq_zero i (hz.eq_of_tgt _ _)
    exact hT.of_epi i
  · intro h N q _ hn
    have hN := h.of_epi q
    have hleft := (homFinrank_pos_iff k X N).2 (hN.exists_nonzero_hom hn)
    have hright := (P.surjective_precompose_iff_no_hom_nakayamaKernel k N).1
      (P.surjective_precompose_of_generatedBy hs hN)
    have hz := (homFinrank_eq_zero_iff k N (P.nakayamaKernel k)).2 (fun f ↦ hright.elim f 0)
    rw [P.eulerWeight_eq_perpendicular_difference k, hz, Nat.cast_zero, sub_zero]
    exact Int.natCast_pos.mpr hleft

include k in
/-- A module in the weak torsion class has a semistable quotient by its
trace from the presilting cokernel. -/
theorem exists_semistable_quotient_of_no_hom_nakayamaKernel (P : TwoTerm R) (hP : P.IsPresilting)
    (M : FGModuleCat.{u} R) (hM : Subsingleton (M ⟶ P.nakayamaKernel k)) :
    ∃ (T : FGModuleCat.{u} R) (i : T ⟶ M), Mono i ∧ IsGeneratedBy (cokernel P.differential) T ∧
      (P.eulerWeight k).IsSemistable (cokernel i) := by
  obtain ⟨T, i, hi, hT, hzero⟩ := P.exists_generated_subobject_cokernel_hom_zero k hP M
  have hright : Subsingleton (cokernel i ⟶ P.nakayamaKernel k) :=
    ⟨fun f g ↦ (cancel_epi (cokernel.π i)).1 (hM.elim _ _)⟩
  exact ⟨T, i, hi, hT, (P.isSemistable_eulerWeight_iff_perpendicular k hP _).2 ⟨hzero, hright⟩⟩

end TwoTerm

end EFiniteCharacterizations
