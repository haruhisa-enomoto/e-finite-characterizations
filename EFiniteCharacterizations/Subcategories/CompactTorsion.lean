module

public import EFiniteCharacterizations.Subcategories.TorsionSeparation
public import EFiniteCharacterizations.LinearAlgebra.IntegralConeFacets

/-! # Compact torsion classes in an E-finite algebra -/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped ModuleCat.Algebra

universe u

namespace EFiniteCharacterizations

variable (k : Type u) [Field k] {R : Type u} [Ring R] [Algebra k R] [Module.Finite k R]
  [IsNoetherianRing R] [IsArtinianRing R]

/-- The torsion class generated by one module. -/
abbrev generatedTorsionClass (M : FGModuleCat.{u} R) := leftHomOrthogonal (rightHomOrthogonal M)

omit [IsArtinianRing R] in
include k in
theorem strictTorsionClass_eq_leftOrthogonal (θ : Weight (FGModuleCat.{u} R)) :
    θ.strictTorsionClass = leftHomOrthogonal θ.weakTorsionFreeClass := by
  funext X
  refine propext ⟨fun hx Y hy f ↦ Weight.strict_weak_hom_zero hx hy f, fun hx ↦ ?_⟩
  obtain ⟨Q, p, hp, hK, hQ⟩ := θ.exists_strict_torsion_decomposition k X
  have hz : p = 0 := hx Q hQ p
  have : IsIso (kernel.ι p) := by subst p; infer_instance
  intro Y q hq hn
  exact hK (kernel.ι p ≫ q) hn

include k in
/-- Finite generation of the quotient cone gives a single module whose
left Hom-orthogonal is the compact torsion class. -/
theorem exists_left_perpendicular_of_isEFinite (h : IsEFinite R) (M : FGModuleCat.{u} R) :
    ∃ N : FGModuleCat.{u} R, ∀ X, generatedTorsionClass M X ↔ ∀ f : X ⟶ N, f = 0 := by
  classical
  let A := nonzeroQuotientClasses M
  have hA : A.Finite := (finite_classes_of_groundFinrank_le (R := R) k (Module.finrank k (M.obj : Type u))).subset (by
    rintro _ ⟨Q,q,hq,_,rfl⟩
    exact ⟨Q, groundFinrank_le_of_epi k q, rfl⟩)
  let := hA.fintype
  let m := Fintype.card A
  let e := (Fintype.equivFin A).symm
  let V (i : Fin m) := (e i).val
  obtain ⟨n,q,hq⟩ := exists_injective_projective_weight_coordinates (R := R) k
  obtain ⟨H,hH⟩ := Farkas.finite_lattice_cone_tests (fun t ↦ projectiveClassWeight k (q t)) hq V
  let g (w : H) := ∑ t, w.val t • q t
  choose P hp hg using fun w : H ↦ h (g w)
  let N (w : H) := (P w).nakayamaKernel k
  have hw (w : H) (z) : (P w).eulerWeight k z = (∑ t, w.val t • projectiveClassWeight k (q t)) z := by
    rw [← (P w).projectiveClassWeight_eq_eulerWeight k, hg]
    simp [g]
  have hM (w : H) : Subsingleton (M ⟶ N w) := by
    apply ((P w).nonneg_eulerWeight_all_quotients_iff k (hp w) M).1
    intro Q p hep
    by_cases hz : IsZero Q
    · exact ((P w).eulerWeight k |>.eval_isZero hz).ge
    let x : A := ⟨_, Q,p,hep,hz,rfl⟩
    let i := e.symm x
    have hV : V i = GrothendieckGroup.of Q := congrArg Subtype.val (e.apply_symm_apply x)
    change 0 ≤ (P w).eulerWeight k (GrothendieckGroup.of Q)
    rw [hw, ← hV]
    apply (hH (V i)).2 _ w.val w.property
    exact ⟨1, Pi.single i 1, by decide, by intro j; simp [Pi.single_apply]; split <;> decide, by simp [Pi.single_apply, ite_smul]⟩
  refine ⟨⨁ N, fun X ↦ ⟨fun hX f ↦ ?_, fun hX ↦ ?_⟩⟩
  · apply biproduct.hom_ext
    intro w
    simpa using hX (N w) (fun a ↦ (hM w).elim a 0) (f ≫ biproduct.π N w)
  · obtain ⟨L,Z,i,p,wi,hL,hZ,hs⟩ := (isTorsionPair_generated M).2 X
    have := hs.epi_g
    have hZzero : IsZero Z := by
      by_contra hn
      obtain ⟨s, hpos, hneg⟩ := exists_weight_separating_quotients_subobjects k
        (equalClassHom_of_isEFinite k h) (fun _ : Unit ↦ M) (fun _ : Unit ↦ Z) (fun _ _ ↦ hZ)
      have htest : ∀ w ∈ H, 0 ≤ (∑ t, w t • projectiveClassWeight k (q t)) (GrothendieckGroup.of Z) := by
        intro w hmem
        let j : H := ⟨w,hmem⟩
        have hnX : Subsingleton (X ⟶ N j) := by
          constructor
          intro a b
          have hz (c : X ⟶ N j) : c = 0 := by
            have H := congrArg (· ≫ biproduct.π N j) (hX (c ≫ biproduct.ι N j))
            simpa using H
          exact (hz a).trans (hz b).symm
        have hz := ((P j).nonneg_eulerWeight_all_quotients_iff k (hp j) X).2 hnX p
        exact (hw j _ ▸ hz : 0 ≤ (∑ t, w t • projectiveClassWeight k (q t)) (GrothendieckGroup.of Z))
      obtain ⟨d,a,hd,ha,he⟩ := (hH _).1 htest
      let θ := projectiveClassWeight (R := R) k s
      have hz : θ (GrothendieckGroup.of Z) < 0 := hneg () (𝟙 Z) hn
      have hv (j : Fin m) : 0 < θ (V j) := by
        obtain ⟨Q,p,hp,hn,he⟩ := (e j).property
        change 0 < θ (e j).val
        exact he ▸ (hpos () p hn : 0 < θ (GrothendieckGroup.of Q))
      have hh := congrArg θ he
      simp only [map_zsmul,map_sum,zsmul_eq_mul,Int.cast_id] at hh
      exact (mul_neg_of_pos_of_neg hd hz).not_ge (hh ▸ Finset.sum_nonneg fun j _ ↦ mul_nonneg (ha j) (hv j).le)
    have : Epi i := hs.exact.epi_f_iff.mpr (hZzero.eq_of_tgt p 0)
    exact leftHomOrthogonal_of_epi i hL

include k in
/-- Every compact torsion class of an E-finite algebra is functorially finite. -/
theorem functoriallyFinite_generatedTorsionClass_of_isEFinite (h : IsEFinite R) (M : FGModuleCat.{u} R) :
    FunctoriallyFinite (generatedTorsionClass M) := by
  obtain ⟨N,hN⟩ := exists_left_perpendicular_of_isEFinite k h M
  have hMN : rightHomOrthogonal M N := (hN M).1 (fun _ hY ↦ hY)
  obtain ⟨g, hg, hn⟩ := exists_weight_separating_quotients_subobjects k (equalClassHom_of_isEFinite k h)
    (fun _ : Unit ↦ M) (fun _ : Unit ↦ N) (fun _ _ ↦ hMN)
  let θ := projectiveClassWeight (R := R) k g
  have hF : θ.weakTorsionFreeClass N := by
    intro U i hi
    by_cases hz : IsZero U
    · exact (θ.eval_isZero hz).le
    · exact (hn () i hz).le
  have he : generatedTorsionClass M = θ.strictTorsionClass := by
    funext X
    refine propext ⟨fun hx ↦ ?_, fun hx ↦ (hN X).2 (fun f ↦ Weight.strict_weak_hom_zero hx hF f)⟩
    rw [strictTorsionClass_eq_leftOrthogonal k θ]
    exact fun Y hy f ↦ hx Y (fun a ↦ Weight.strict_weak_hom_zero (hg ()) hy a) f
  rw [he]
  exact functoriallyFinite_strictTorsion_of_isEFinite k h g

/-- A finite family of torsion decompositions for the first pair is also a
family of torsion decompositions for a single functorially finite torsion
class. The inclusions in the given sequences thus represent the same radicals. -/
def TorsionRadicalApproximation (R : Type u) [Ring R] [IsNoetherianRing R] : Prop :=
  ∀ T F : ObjectProperty (FGModuleCat.{u} R), IsTorsionPair T F →
    ∀ (n : ℕ) (S : Fin n → ShortComplex (FGModuleCat.{u} R)),
      (∀ i, (S i).ShortExact ∧ T (S i).X₁ ∧ F (S i).X₃) →
      ∃ T₀ F₀ : ObjectProperty (FGModuleCat.{u} R), IsTorsionPair T₀ F₀ ∧ FunctoriallyFinite T₀ ∧
        ∀ i, T₀ (S i).X₁ ∧ F₀ (S i).X₃

include k in
theorem torsionRadicalApproximation_of_isEFinite (h : IsEFinite R) : TorsionRadicalApproximation R := by
  intro T F hpair n S hs
  obtain ⟨g, hpos, hneg⟩ := exists_weight_separating_quotients_subobjects k (equalClassHom_of_isEFinite k h)
    (fun i ↦ (S i).X₁) (fun j ↦ (S j).X₃) (fun i j f ↦ hpair.1 f (hs i).2.1 (hs j).2.2)
  let θ := projectiveClassWeight (R := R) k g
  refine ⟨θ.strictTorsionClass, θ.weakTorsionFreeClass, ⟨fun f hT hF ↦ Weight.strict_weak_hom_zero hT hF f,
    fun X ↦ ?_⟩, functoriallyFinite_strictTorsion_of_isEFinite k h g, fun i ↦ ⟨hpos i, ?_⟩⟩
  · obtain ⟨Q,p,hp,hK,hQ⟩ := θ.exists_strict_torsion_decomposition k X
    exact ⟨_,Q,kernel.ι p,p,kernel.condition p,hK,hQ,ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel p)
      (by dsimp; infer_instance) (by dsimp; infer_instance)⟩
  · intro U j hj
    by_cases hz : IsZero U
    · exact (θ.eval_isZero hz).le
    · exact (hneg i j hz).le

end EFiniteCharacterizations
