module

public import EFiniteCharacterizations.LargeModules.GenericBrick
public import Mathlib.RingTheory.FiniteLength

/-! # Endofinite modules and the extension-splitting criterion for generic grains -/

@[expose] public section

open CategoryTheory
open scoped ModuleCat.Algebra

universe u
namespace EFiniteCharacterizations

variable {R : Type u} [Ring R]

def IsEndofinite (M : ModuleCat.{u} R) : Prop := IsFiniteLength (Module.End R M) M

/-- Finite length for a compatible scalar action bounds length over the endomorphisms. -/
theorem isEndofinite_of_scalar_tower (M : ModuleCat.{u} R) (K : Type*) [DivisionRing K]
    [Module K M] [Module.Finite K M] [SMul K (Module.End R M)]
    [IsScalarTower K (Module.End R M) M] : IsEndofinite M :=
  isFiniteLength_iff_isNoetherian_isArtinian.mpr
    ⟨isNoetherian_of_tower K inferInstance, isArtinian_of_tower K inferInstance⟩

/-- A summand of an endofinite module is endofinite. The fully invariant
submodules of the summand embed in those of the original module by testing
membership against every map to the summand. -/
theorem IsEndofinite.of_retract {M N : ModuleCat.{u} R} (h : IsEndofinite N)
    (r : Retract M N) : IsEndofinite M := by
  let extend (U : Submodule (Module.End R M) M) : Submodule (Module.End R N) N :=
    { carrier := {x | ∀ f : N →ₗ[R] M, f x ∈ U}
      zero_mem' := fun f ↦ by simp
      add_mem' := fun hx hy f ↦ by simpa using U.add_mem (hx f) (hy f)
      smul_mem' := fun a x hx f ↦ hx (f.comp a) }
  have strict : StrictMono extend := by
    intro U V huv
    refine lt_of_le_not_ge (fun x hx f ↦ huv.le (hx f)) (fun hback ↦ huv.not_ge ?_)
    intro m hm
    have hv : r.i.hom m ∈ extend V := fun f ↦ V.smul_mem (f.comp r.i.hom) hm
    have hh := hback hv r.r.hom
    have eq := DFunLike.congr_fun (congrArg ModuleCat.Hom.hom r.retract) m
    exact (show r.r.hom (r.i.hom m) = m from eq) ▸ hh
  obtain ⟨hn,ha⟩ := isFiniteLength_iff_isNoetherian_isArtinian.mp h
  apply isFiniteLength_iff_isNoetherian_isArtinian.mpr
  exact ⟨isNoetherian_iff.mpr (InvImage.wf extend hn.wf |>.mono (fun _ _ hh ↦ strict hh)),
    (InvImage.wf extend ha |>.mono
      (fun _ _ hh ↦ strict hh))⟩

variable (k : Type u) [Field k] [Algebra k R]

theorem IsGenericBrick.isEndofinite {M : ModuleCat.{u} R} (h : IsGenericBrick k M) :
    IsEndofinite M := by
  let := h.divisionRing k
  let := h.endofinite
  exact isFiniteLength_iff_isNoetherian_isArtinian.mpr ⟨inferInstance,inferInstance⟩

/-- Vanishing of Ext¹ on finite-dimensional modules cogenerated by N, expressed
by splitting every extension with kernel N and such a quotient. -/
def SplitsOnCogeneratedModules (N : ModuleCat.{u} R) : Prop :=
  ∀ (S : ShortComplex (ModuleCat.{u} R)), S.ShortExact → Nonempty (S.X₁ ≅ N) →
    Module.Finite k S.X₃ → (∃ (n : ℕ) (f : S.X₃ →ₗ[R] (Fin n → N)), Function.Injective f) →
    ∃ s : S.X₃ ⟶ S.X₂, s ≫ S.g = 𝟙 S.X₃

structure IsGenericGrain (N : ModuleCat.{u} R) : Prop where
  infinite : ¬ Module.Finite k N
  indecomposable : Indecomposable N
  endofinite : IsEndofinite N
  splits : SplitsOnCogeneratedModules k N

/-- Finitely many coordinates of a product embedding already separate points
of an Artinian module. -/
theorem finite_coordinates_of_product_embedding {ι : Type*} {X N : ModuleCat.{u} R}
    [IsArtinian R X] (f : X →ₗ[R] (ι → N)) (hf : Function.Injective f) :
    ∃ (n : ℕ) (a : Fin n → ι), Function.Injective (fun x : X ↦ fun i ↦ f x (a i)) := by
  classical
  let K (s : Finset ι) : Submodule R X := ⨅ i ∈ s, (LinearMap.proj i ∘ₗ f).ker
  obtain ⟨U,⟨s,rfl⟩,hm⟩ := wellFounded_lt.has_min (Set.range K) ⟨_,∅,rfl⟩
  have hle (i : ι) : K s ≤ (LinearMap.proj i ∘ₗ f).ker := by
    have he : K (insert i s) = (LinearMap.proj i ∘ₗ f).ker ⊓ K s := by
      ext x
      simp only [K,Submodule.mem_iInf,Submodule.mem_inf,Finset.mem_insert]
      aesop
    have hh : K s ≤ K (insert i s) := by
      by_contra h
      exact hm _ ⟨insert i s,rfl⟩ (lt_of_le_not_ge (he ▸ inf_le_right) h)
    exact hh.trans (he ▸ inf_le_left)
  let a := (s.equivFin).symm
  refine ⟨s.card, fun i ↦ (a i).val, fun x y h ↦ ?_⟩
  have hs : x - y ∈ K s := by
    simp only [K,Submodule.mem_iInf]
    intro i hi
    have hh := congrFun h (s.equivFin ⟨i,hi⟩)
    simpa [a,LinearMap.mem_ker,map_sub,sub_eq_zero] using hh
  apply hf
  funext i
  have hz := hle i hs
  simpa [LinearMap.mem_ker,map_sub,sub_eq_zero] using hz

/-- The splitting test for a grain also applies when the finite-dimensional
quotient embeds into an arbitrary product. -/
theorem IsGenericGrain.splits_of_product {N : ModuleCat.{u} R} (h : IsGenericGrain k N)
    (S : ShortComplex (ModuleCat.{u} R)) (hs : S.ShortExact) (hn : Nonempty (S.X₁ ≅ N))
    [Module.Finite k S.X₃] {ι : Type*} (f : S.X₃ →ₗ[R] (ι → N)) (hf : Function.Injective f) :
    ∃ s : S.X₃ ⟶ S.X₂, s ≫ S.g = 𝟙 S.X₃ := by
  let := isArtinian_of_tower k (S := R) (M := S.X₃) inferInstance
  obtain ⟨n,a,ha⟩ := finite_coordinates_of_product_embedding f hf
  exact h.splits S hs hn inferInstance ⟨n, LinearMap.pi (fun i ↦ (LinearMap.proj (a i) : (ι → N) →ₗ[R] N) ∘ₗ f), ha⟩

/-- A summand inherits the splitting test from its direct sum with another module. -/
theorem splitsOnCogeneratedModules_summand (N L : ModuleCat.{u} R)
    (h : SplitsOnCogeneratedModules k (ModuleCat.of R (N × L))) :
    SplitsOnCogeneratedModules k N := by
  intro S hs ⟨e⟩ hfinite ⟨n,f,hf⟩
  let i := ModuleCat.ofHom (S.f.hom.prodMap (LinearMap.id : L →ₗ[R] L))
  let q := ModuleCat.ofHom (S.g.hom.comp (LinearMap.fst R S.X₂ L))
  have w : i ≫ q = 0 := by
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    exact DFunLike.congr_fun (congrArg ModuleCat.Hom.hom S.zero) x.1
  let D := ShortComplex.mk i q w
  have hi : Mono i := (ModuleCat.mono_iff_injective _).2 ((hs.moduleCat_injective_f).prodMap (fun _ _ h ↦ h))
  have hq : Epi q := (ModuleCat.epi_iff_surjective _).2 (fun y ↦ by
    obtain ⟨x,hx⟩ := hs.moduleCat_surjective_g y
    exact ⟨(x,0),hx⟩)
  have hex := (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact S).mp hs.exact
  have hd : D.ShortExact := ShortComplex.ShortExact.mk'
    ((ShortComplex.ShortExact.moduleCat_exact_iff_function_exact D).2 (fun x ↦ by
      change S.g x.1 = 0 ↔ ∃ y : S.X₁ × L, (S.f y.1,y.2) = x
      constructor
      · intro hx
        obtain ⟨a,ha⟩ := (hex x.1).1 hx
        exact ⟨(a,x.2),Prod.ext ha rfl⟩
      · rintro ⟨y,rfl⟩
        exact (hex _).2 ⟨_,rfl⟩)) hi hq
  let j := LinearMap.inl R N L
  let F := LinearMap.pi (fun a : Fin n ↦ j.comp ((LinearMap.proj a).comp f))
  have hF : Function.Injective F := fun x y he ↦ hf (funext fun a ↦ congrArg Prod.fst (congrFun he a))
  obtain ⟨s,hh⟩ := h D hd ⟨((e.toLinearEquiv).prodCongr (LinearEquiv.refl R L)).toModuleIso⟩
    hfinite ⟨n,F,hF⟩
  exact ⟨s ≫ ModuleCat.ofHom (LinearMap.fst R S.X₂ L), (Category.assoc ..).trans hh⟩

/-- The extension-splitting test passes to any retract. -/
theorem SplitsOnCogeneratedModules.of_retract {M N : ModuleCat.{u} R}
    (h : SplitsOnCogeneratedModules k N) (r : Retract M N) : SplitsOnCogeneratedModules k M := by
  let L := ModuleCat.of R r.r.hom.ker
  let sum : (M × L) →ₗ[R] N := r.i.hom.coprod r.r.hom.ker.subtype
  have pr (x : M) : r.r.hom (r.i.hom x) = x :=
    DFunLike.congr_fun (congrArg ModuleCat.Hom.hom r.retract) x
  have hi : Function.Injective sum := by
    apply (injective_iff_map_eq_zero sum).2
    rintro ⟨x,y⟩ hh
    change r.i.hom x + y.val = 0 at hh
    have hx := congrArg r.r.hom hh
    simp only [map_add,pr,LinearMap.mem_ker.mp y.property,add_zero,map_zero] at hx
    subst x
    have hy : y.val = 0 := by simpa using hh
    exact Prod.ext rfl (Subtype.ext hy)
  have hs : Function.Surjective sum := fun x ↦
    ⟨(r.r.hom x,⟨x - r.i.hom (r.r.hom x),by simp [LinearMap.mem_ker,pr]⟩), by
      change r.i.hom (r.r.hom x) + (x - r.i.hom (r.r.hom x)) = x
      abel⟩
  let e := LinearEquiv.ofBijective sum ⟨hi,hs⟩
  apply splitsOnCogeneratedModules_summand k M L
  intro S hS ⟨j⟩ hf hcg
  obtain ⟨n,f,hinj⟩ := hcg
  let g := LinearMap.pi (fun a ↦ e.toLinearMap.comp ((LinearMap.proj a).comp f))
  exact h S hS ⟨j ≪≫ e.toModuleIso⟩ hf ⟨n,g,fun _ _ he ↦
    hinj (funext (fun a ↦ e.injective (congrFun he a)))⟩

/-- An infinite-dimensional indecomposable summand of an endofinite module
satisfying the splitting test is a generic grain. -/
theorem isGenericGrain_of_retract {M N : ModuleCat.{u} R} (r : Retract M N)
    (he : IsEndofinite N) (hs : SplitsOnCogeneratedModules k N)
    (hi : ¬ Module.Finite k M) (hd : Indecomposable M) : IsGenericGrain k M :=
  ⟨hi,hd,he.of_retract r,hs.of_retract k r⟩

open CategoryTheory.Limits in
/-- Rigidity of an injective copresentation gives lifting from its kernel. -/
theorem kernel_lifts_of_copresentation {I J : ModuleCat.{u} R} [Injective J] (d : I ⟶ J)
    (rigid : ∀ b : I ⟶ J, ∃ (a : I ⟶ I) (c : J ⟶ J), b = a ≫ d + d ≫ c)
    (f : kernel d ⟶ J) : ∃ a : kernel d ⟶ I, a ≫ d = f := by
  obtain ⟨a,c,he⟩ := rigid (Injective.factorThru f (kernel.ι d))
  refine ⟨kernel.ι d ≫ a, ?_⟩
  have hh := Injective.comp_factorThru f (kernel.ι d)
  rw [he,Preadditive.comp_add,← Category.assoc (kernel.ι d) d,kernel.condition,zero_comp,add_zero] at hh
  exact (Category.assoc ..).trans hh

open CategoryTheory.Limits in
/-- Lifting through the copresentation on the quotient splits an extension by the kernel. -/
theorem splits_extension_of_kernel_lifting {I J : ModuleCat.{u} R} [Injective I] (d : I ⟶ J)
    (S : ShortComplex (ModuleCat.{u} R)) (hs : S.ShortExact) (e : S.X₁ ≅ kernel d)
    (lift : ∀ f : S.X₃ ⟶ J, ∃ a : S.X₃ ⟶ I, a ≫ d = f) :
    ∃ s : S.X₃ ⟶ S.X₂, s ≫ S.g = 𝟙 S.X₃ := by
  let := hs.mono_f
  let b := Injective.factorThru (e.hom ≫ kernel.ι d) S.f
  have hb : S.f ≫ b = e.hom ≫ kernel.ι d := Injective.comp_factorThru ..
  obtain ⟨f,hf⟩ := CokernelCofork.IsColimit.desc' hs.gIsCokernel (b ≫ d)
    (by rw [← Category.assoc,hb,Category.assoc,kernel.condition,comp_zero])
  change S.g ≫ f = b ≫ d at hf
  obtain ⟨a,ha⟩ := lift f
  let r := kernel.lift d (b - S.g ≫ a) (by simp [Preadditive.sub_comp,Category.assoc,ha,hf])
  have hr : S.f ≫ r = e.hom := by
    apply (cancel_mono (kernel.ι d)).mp
    simp [r,Category.assoc,Preadditive.comp_sub,hb,S.zero_assoc]
  let split := ShortComplex.Splitting.ofExactOfRetraction S hs.exact (r ≫ e.inv)
    (by rw [← Category.assoc,hr,e.hom_inv_id]) hs.epi_g
  exact ⟨split.s,split.s_g⟩

open CategoryTheory.Limits in
theorem cogenerated_lifts_of_rigid {I J : ModuleCat.{u} R}
    [Injective I] [Injective J] (d : I ⟶ J)
    (rigid : ∀ b : I ⟶ J, ∃ (a : I ⟶ I) (c : J ⟶ J), b = a ≫ d + d ≫ c) {X : ModuleCat.{u} R}
    {n : ℕ} (t : X →ₗ[R] (Fin n → (kernel d).carrier)) (ht : Function.Injective t)
    (f : X ⟶ J) : ∃ a : X ⟶ I, a ≫ d = f := by
  classical
  let V := ModuleCat.of R (Fin n → (kernel d).carrier)
  let i : X ⟶ V := ModuleCat.ofHom t
  have : Mono i := (ModuleCat.mono_iff_injective i).2 ht
  let b := Injective.factorThru f i
  let j (a : Fin n) : kernel d ⟶ V := ModuleCat.ofHom (LinearMap.single R (fun _ : Fin n ↦ (kernel d).carrier) a)
  choose l hl using fun a ↦ kernel_lifts_of_copresentation d rigid (j a ≫ b)
  let L : V ⟶ I := ModuleCat.ofHom (LinearMap.lsum R (fun _ : Fin n ↦ (kernel d).carrier) ℕ (fun a ↦ (l a).hom))
  have hL : L ≫ d = b := by
    apply ModuleCat.hom_ext
    apply LinearMap.pi_ext
    intro a x
    change d.hom ((LinearMap.lsum R _ ℕ (fun a ↦ (l a).hom)) (Pi.single a x)) = b.hom (Pi.single a x)
    rw [LinearMap.lsum_piSingle]
    exact DFunLike.congr_fun (congrArg ModuleCat.Hom.hom (hl a)) x
  exact ⟨i ≫ L, by rw [Category.assoc,hL]; exact Injective.comp_factorThru ..⟩

open CategoryTheory.Limits in
/-- The kernel of a rigid map of injectives satisfies the grain splitting test. -/
theorem splitsOnCogeneratedModules_kernel_of_rigid {I J : ModuleCat.{u} R}
    [Injective I] [Injective J] (d : I ⟶ J)
    (rigid : ∀ b : I ⟶ J, ∃ (a : I ⟶ I) (c : J ⟶ J), b = a ≫ d + d ≫ c) :
    SplitsOnCogeneratedModules k (kernel d) := by
  classical
  intro S hs he _ hX
  obtain ⟨n,t,ht⟩ := hX
  apply splits_extension_of_kernel_lifting d S hs he.some
  intro f
  exact cogenerated_lifts_of_rigid d rigid t ht f

open CategoryTheory.Limits in
theorem extends_to_rigid_kernel {I J : ModuleCat.{u} R} [Injective I] [Injective J]
    (d : I ⟶ J) (rigid : ∀ b : I ⟶ J, ∃ (a : I ⟶ I) (c : J ⟶ J), b = a ≫ d + d ≫ c)
    (S : ShortComplex (ModuleCat.{u} R)) (hs : S.ShortExact) {m : ℕ}
    (u : S.X₃ →ₗ[R] (Fin m → (kernel d).carrier)) (hu : Function.Injective u)
    (a : S.X₁ ⟶ kernel d) : ∃ b : S.X₂ ⟶ kernel d, S.f ≫ b = a := by
  let := hs.mono_f
  let g := Injective.factorThru (a ≫ kernel.ι d) S.f
  have hg : S.f ≫ g = a ≫ kernel.ι d := Injective.comp_factorThru ..
  obtain ⟨h,hh⟩ := CokernelCofork.IsColimit.desc' hs.gIsCokernel (g ≫ d)
    (by rw [← Category.assoc,hg,Category.assoc,kernel.condition,comp_zero])
  change S.g ≫ h = g ≫ d at hh
  obtain ⟨l,hl⟩ := cogenerated_lifts_of_rigid d rigid u hu h
  refine ⟨kernel.lift d (g - S.g ≫ l) (by simp [Preadditive.sub_comp,Category.assoc,hl,hh]), ?_⟩
  apply (cancel_mono (kernel.ι d)).mp
  simp [Category.assoc,Preadditive.comp_sub,hg,S.zero_assoc]

open CategoryTheory.Limits in
/-- A short exact sequence with endpoints embedded in finite powers of a rigid
kernel admits such an embedding of its middle term. -/
theorem cogenerated_extension_of_rigid {I J : ModuleCat.{u} R} [Injective I] [Injective J]
    (d : I ⟶ J) (rigid : ∀ b : I ⟶ J, ∃ (a : I ⟶ I) (c : J ⟶ J), b = a ≫ d + d ≫ c)
    (S : ShortComplex (ModuleCat.{u} R)) (hs : S.ShortExact) {n m : ℕ}
    (t : S.X₁ →ₗ[R] (Fin n → (kernel d).carrier)) (ht : Function.Injective t)
    (u : S.X₃ →ₗ[R] (Fin m → (kernel d).carrier)) (hu : Function.Injective u) :
    ∃ v : S.X₂ →ₗ[R] (Fin (n + m) → (kernel d).carrier), Function.Injective v := by
  classical
  choose b hb using fun i : Fin n ↦ extends_to_rigid_kernel d rigid S hs u hu (ModuleCat.ofHom ((LinearMap.proj i).comp t))
  let coord : Fin n ⊕ Fin m → S.X₂ →ₗ[R] (kernel d).carrier :=
    Sum.elim (fun i ↦ (b i).hom) (fun j ↦ (LinearMap.proj j).comp (u.comp S.g.hom))
  let v := LinearMap.pi (fun i ↦ coord (finSumFinEquiv.symm i))
  refine ⟨v,(LinearMap.ker_eq_bot.mp ((LinearMap.ker_eq_bot').2 ?_))⟩
  intro x hx
  have zeroAt (j : Fin n ⊕ Fin m) : coord j x = 0 := by
    simpa [v] using congrFun hx (finSumFinEquiv j)
  have hg : S.g x = 0 := hu (by ext j; exact zeroAt (.inr j) |>.trans (by simp))
  obtain ⟨y,rfl⟩ := ((ShortComplex.ShortExact.moduleCat_exact_iff_function_exact S).1 hs.exact x).1 hg
  have hy : y = 0 := ht (by
    funext i
    have hh := DFunLike.congr_fun (congrArg ModuleCat.Hom.hom (hb i)) y
    exact hh.symm.trans ((zeroAt (.inl i)).trans (by simp)))
  simp [hy]

end EFiniteCharacterizations
