module

public import Mathlib.Algebra.Field.Subfield.Basic
public import Mathlib.LinearAlgebra.Basis.Submodule
public import Mathlib.LinearAlgebra.Matrix.Basis
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-! # The algebra over the coordinate field of a matrix image -/

@[expose] public section

namespace EFiniteCharacterizations

variable {B K n ι : Type*} [Ring B] [Field K] [Fintype n] [DecidableEq n]
    (q : B →+* Matrix n n K) (b : Module.Basis ι K (Matrix n n K))

/-- Field generated by all coordinates of the image in the chosen matrix basis. -/
def matrixCoefficientField : Subfield K :=
  Subfield.closure (Set.range fun p : B × ι ↦ b.repr (q p.1) p.2)

local notation "L" => matrixCoefficientField q b

/-- The subalgebra generated by the image over its coordinate field. -/
def matrixImageAlgebra : Subalgebra L (Matrix n n K) :=
  Algebra.adjoin L (Set.range q)

theorem matrixImageAlgebra_toSubmodule (hb : Set.range b ⊆ Set.range q) :
    (matrixImageAlgebra q b).toSubmodule = Submodule.span L (Set.range b) := by
  apply le_antisymm
  · apply (Algebra.adjoin_toSubmodule_le L).2
    intro x hx
    have hmem : x ∈ q.range.toSubmonoid := (Submonoid.closure_le.mpr (by
      intro y hy
      exact hy) : Submonoid.closure (Set.range q) ≤ q.range.toSubmonoid) hx
    obtain ⟨y,rfl⟩ := hmem
    apply (b.mem_span_iff_repr_mem L _).2
    intro i
    exact ⟨⟨_,Subfield.subset_closure ⟨(y,i),rfl⟩⟩,rfl⟩
  · exact Submodule.span_le.mpr fun _ hx ↦ Algebra.subset_adjoin (hb hx)

/-- The ambient matrix basis is also a basis over the coordinate field. -/
noncomputable def matrixImageBasis (hb : Set.range b ⊆ Set.range q) :
    Module.Basis ι L (matrixImageAlgebra q b) :=
  (b.restrictScalars L).map
    (LinearEquiv.ofEq _ _ (matrixImageAlgebra_toSubmodule q b hb).symm)

@[simp] theorem matrixImageBasis_apply (hb : Set.range b ⊆ Set.range q) (i : ι) :
    (matrixImageBasis q b hb i).val = b i := by
  change (b.restrictScalars L i).val = _
  exact b.restrictScalars_apply L i

theorem matrixImageBasis_repr (hb : Set.range b ⊆ Set.range q)
    (x : matrixImageAlgebra q b) (i : ι) :
    ((matrixImageBasis q b hb).repr x i).val = b.repr x.val i := by
  exact b.restrictScalars_repr_apply L _ i

/-- The image map into the algebra defined over the coordinate field. -/
def toMatrixImageAlgebra : B →+* matrixImageAlgebra q b :=
  q.codRestrict (matrixImageAlgebra q b).toSubring (fun x ↦ Algebra.subset_adjoin ⟨x,rfl⟩)

end EFiniteCharacterizations
