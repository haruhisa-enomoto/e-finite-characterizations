module

public import EFiniteCharacterizations.LargeModules.GrainTorsionPair
public import EFiniteCharacterizations.Silting.Fans.PresiltingConeWalls

/-! # The finite modules cogenerated by a presilting Nakayama kernel -/

@[expose] public section
open CategoryTheory CategoryTheory.Limits
open scoped ModuleCat.Algebra

universe u
namespace EFiniteCharacterizations

variable {R : Type u} [Ring R] [IsNoetherianRing R] (k : Type u) [Field k]
  [Algebra k R] [Module.Finite k R]

omit [IsNoetherianRing R] in
theorem hom_zero_of_cogenerated {A M Y : FGModuleCat.{u} R} (hA : Subsingleton (A ⟶ Y))
    (hM : cogeneratedByModule Y.obj M) : Subsingleton (A ⟶ M) := by
  obtain ⟨n,t,ht⟩ := hM
  constructor
  intro f g
  apply FGModuleCat.hom_ext
  ext x
  apply ht
  funext i
  let b : M ⟶ Y := FGModuleCat.ofHom ((LinearMap.proj i).comp t)
  exact DFunLike.congr_fun (congrArg (fun z : A ⟶ Y ↦ z.hom.hom) (hA.elim (f ≫ b) (g ≫ b))) x

namespace TwoTerm

include k in
omit [Module.Finite k R] in
theorem injective_precompose_iff_no_hom_cokernel (P : TwoTerm R) (M : FGModuleCat.{u} R) :
    Function.Injective (P.precompose M) ↔ Subsingleton (cokernel P.differential ⟶ M) := by
  change Function.Injective (Linear.leftComp k M P.differential) ↔ _
  rw [← LinearMap.ker_eq_bot, ← Submodule.subsingleton_iff_eq_bot]
  exact (cokernelHomLinearEquiv k P.differential M).toEquiv.subsingleton_congr.symm

/-- A map into the Nakayama kernel extends across a submodule if the
quotient receives no nonzero maps from the cokernel of the differential. -/
theorem extends_to_nakayamaKernel (P : TwoTerm R) (S : ShortComplex (FGModuleCat.{u} R)) (hs : S.ShortExact)
    (hq : Subsingleton (cokernel P.differential ⟶ S.X₃)) (a : S.X₁ ⟶ P.nakayamaKernel k) :
    ∃ b : S.X₂ ⟶ P.nakayamaKernel k, S.f ≫ b = a := by
  let _ := P.projective_source
  let _ := P.projective_target
  let d := nakayamaMorphism k P.differential
  have := hs.mono_f
  have hin : Function.Injective (Linear.rightComp k P.source S.f) := fun _ _ e ↦ (cancel_mono S.f).1 e
  obtain ⟨ψ,hψ⟩ := LinearMap.dualMap_surjective_iff.mpr hin
    ((nakayamaPairing k P.source S.X₁).symm (a ≫ kernel.ι d))
  let g := nakayamaPairing k P.source S.X₂ ψ
  have hg : S.f ≫ g = a ≫ kernel.ι d := by
    rw [← nakayamaPairing_dual_rightComp,hψ,LinearEquiv.apply_symm_apply]
  obtain ⟨h,hh⟩ := CokernelCofork.IsColimit.desc' hs.gIsCokernel (g ≫ d)
    (by erw [← Category.assoc,hg,Category.assoc,kernel.condition,comp_zero])
  change S.g ≫ h = g ≫ d at hh
  have hinj : Function.Injective (Linear.leftComp k S.X₃ P.differential) :=
    (P.injective_precompose_iff_no_hom_cokernel k S.X₃).2 hq
  obtain ⟨χ,hχ⟩ := LinearMap.dualMap_surjective_iff.mpr hinj ((nakayamaPairing k _ _).symm h)
  let l := nakayamaPairing k P.source S.X₃ χ
  have hl : l ≫ d = h := by
    rw [← nakayamaPairing_dual_leftComp, hχ, LinearEquiv.apply_symm_apply]
  refine ⟨kernel.lift d (g - S.g ≫ l) (by simp [Preadditive.sub_comp,Category.assoc,hl,hh]),?_⟩
  apply (cancel_mono (kernel.ι d)).mp
  erw [Category.assoc,kernel.lift_ι,Preadditive.comp_sub,hg,S.zero_assoc,zero_comp,sub_zero]
  rfl

/-- The modules with no maps to the Nakayama kernel and the finite modules
cogenerated by that kernel form a torsion pair. -/
theorem nakayamaKernel_torsionPair (P : TwoTerm R) (hp : P.IsPresilting) :
    IsTorsionPair (fun M ↦ Subsingleton (M ⟶ P.nakayamaKernel k))
      (cogeneratedByModule (P.nakayamaKernel k).obj) := by
  let _ : IsArtinianRing R := isArtinian_of_tower k inferInstance
  have he : (fun M : FGModuleCat.{u} R ↦ Subsingleton (M ⟶ P.nakayamaKernel k)) =
      perpendicularToModule (P.nakayamaKernel k).obj := by
    funext M
    exact propext ⟨fun h f ↦ congrArg InducedCategory.Hom.hom (h.elim (ObjectProperty.homMk f) 0),
      fun h ↦ ⟨fun f g ↦ FGModuleCat.hom_ext (congrArg ModuleCat.Hom.hom ((h f.hom).trans (h g.hom).symm))⟩⟩
  rw [he]
  apply torsionPair_of_cogenerated_extensions
  intro S hs hc f
  have hq := hom_zero_of_cogenerated ((P.isPresilting_iff_no_hom_nakayamaKernel k).1 hp) hc
  obtain ⟨g,hg⟩ := P.extends_to_nakayamaKernel k S hs hq (ObjectProperty.homMk f)
  exact ⟨g.hom,congrArg InducedCategory.Hom.hom hg⟩

end TwoTerm
end EFiniteCharacterizations
