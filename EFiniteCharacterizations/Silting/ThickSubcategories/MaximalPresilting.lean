module

public import EFiniteCharacterizations.Presentations.SiltingPresentation
public import EFiniteCharacterizations.Silting.Fans.SectorGenerators
public import EFiniteCharacterizations.Presentations.ProjectiveClassSeparation

/-!
# Maximal presilting complexes inside a two-term thick subcategory

Proves that every thick subcategory `H` of `K^{[-1,0]}(proj R)` contains a presilting
complex `U` maximal with respect to compatible direct sums (`exists_maximal_presilting`),
bounding chains of compatible summands by the rank `n = |sim R|`.
-/

@[expose] public section
open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open scoped ModuleCat.Algebra

universe u
namespace EFiniteCharacterizations.TwoTerm

variable {R : Type u} [Ring R] [IsNoetherianRing R]

private abbrev HomAdd (P U : TwoTerm R) := IsInAdd P.homotopyObject U.homotopyObject

private noncomputable abbrev realization := doubleFunctor (C := FGModuleCat.{u} R) ⋙ HomotopyCategory.quotient _ _

private theorem leftAdd (P Q : TwoTerm R) : HomAdd P (P.directSum Q) :=
  (IsInAdd.of_retraction _ _ (inlDirectSum_fstDirectSum P Q)).map realization

private theorem rightAdd (P Q : TwoTerm R) : HomAdd Q (P.directSum Q) :=
  (IsInAdd.of_retraction _ _ (inrDirectSum_sndDirectSum P Q)).map realization

theorem isInAdd_homotopy_directSum {P Q U : TwoTerm R} (hp : IsInAdd P.homotopyObject U.homotopyObject)
    (hq : IsInAdd Q.homotopyObject U.homotopyObject) : IsInAdd (P.directSum Q).homotopyObject U.homotopyObject := by
  let F := realization (R := R)
  have h := congrArg F.map (totalDirectSum P Q)
  rw [F.map_add, F.map_comp, F.map_comp, F.map_id] at h
  exact IsInAdd.of_total hp hq _ _ _ _ h

theorem isInAdd_homotopy_of_stableAdd {P U : TwoTerm R} (h : P.IsInStableAdd U) :
    IsInAdd P.homotopyObject U.homotopyObject := by
  obtain ⟨S,h⟩ := h
  have hz : HomAdd (contractible S) U := ⟨[], (isZero_contractible S).eq_of_src _ _⟩
  exact (h.map realization).trans (isInAdd_homotopy_directSum (IsInAdd.refl _) hz)

private theorem subsingleton_shift_from_add {P Q U : TwoTerm R} (hp : HomAdd P U) (hq : HomAdd Q U)
    (hu : U.IsPresilting) : Function.Surjective (homotopyBoundary P Q) := by
  apply (surjective_boundary_iff_homotopy P Q).2
  intro n hn
  exact subsingleton_from_add hp (subsingleton_to_add (hq.map (shiftFunctor _ n)) ((isPresilting_iff_homotopy U).1 hu n hn))

/-- A two-term member of the additive closure of a presilting object is presilting. -/
theorem isPresilting_of_homotopy_isInAdd {P T : TwoTerm R} (ht : T.IsPresilting)
    (hp : IsInAdd P.homotopyObject T.homotopyObject) : P.IsPresilting :=
  subsingleton_shift_from_add hp hp ht

/-- The subgroup generated by projective classes of summands of finite sums of U.
Every element is the difference of the classes of two objects in add(U). -/
def addClassGroup (U : TwoTerm R) : AddSubgroup (ProjectiveClass R) where
  carrier := {g | ∃ P Q : TwoTerm R, IsInAdd P.homotopyObject U.homotopyObject ∧
    IsInAdd Q.homotopyObject U.homotopyObject ∧ g = P.projectiveClass - Q.projectiveClass}
  zero_mem' := ⟨U, U, .refl _, .refl _, (sub_self _).symm⟩
  add_mem' := by
    rintro x y ⟨P,Q,hP,hQ,rfl⟩ ⟨A,B,hA,hB,rfl⟩
    exact ⟨P.directSum A, Q.directSum B, isInAdd_homotopy_directSum hP hA, isInAdd_homotopy_directSum hQ hB, by simp only [projectiveClass_directSum]; abel⟩
  neg_mem' := by
    rintro x ⟨P,Q,hP,hQ,rfl⟩
    exact ⟨Q,P,hQ,hP,by abel⟩

private theorem class_mem_addClassGroup {P U : TwoTerm R} (h : HomAdd P U) : P.projectiveClass ∈ addClassGroup U :=
  ⟨P.directSum U, U, isInAdd_homotopy_directSum h (.refl _), .refl _, by simp⟩

variable (k : Type u) [Field k] [Algebra k R] [Module.Finite k R]

include k in
/-- A compatible presilting complex belongs to add(U) as soon as a positive
multiple of its class belongs to the subgroup generated by add(U). -/
theorem isInAdd_of_nsmul_class_mem {U P : TwoTerm R} (hc : (U.directSum P).IsPresilting)
    {n : ℕ} (hn : 0 < n) (hg : n • P.projectiveClass ∈ addClassGroup U) :
    IsInAdd P.homotopyObject U.homotopyObject := by
  obtain ⟨A,B,hA,hB,he⟩ := hg
  let D := (P.copies n).directSum B
  have hcopies : HomAdd (P.copies n) (U.directSum P) := ((isInAdd_copies P n).map realization).trans (rightAdd U P)
  have hD : HomAdd D (U.directSum P) := isInAdd_homotopy_directSum hcopies (hB.trans (leftAdd U P))
  have hA' := hA.trans (leftAdd U P)
  have hclass : D.projectiveClass = A.projectiveClass := by
    rw [show D = (P.copies n).directSum B from rfl, projectiveClass_directSum, projectiveClass_copies, he, sub_add_cancel]
  have h := (isInStableAdd_of_isPresilting_of_class_eq k D A (subsingleton_shift_from_add hD hD hc)
    (subsingleton_shift_from_add hA' hA' hc) hclass).1
  exact ((isInAdd_of_pos_copies P hn).map realization).trans ((leftAdd _ _).trans
    ((isInAdd_homotopy_of_stableAdd h).trans hA))

include k in
theorem card_le_simple_count_of_independent_projective_classes {I : Type*} [Fintype I]
    (a : I → ProjectiveClass R) (ha : LinearIndependent ℤ a) :
    Fintype.card I ≤ (simpleIsomorphismClasses R).ncard := by
  classical
  let I := ↥(simpleIsomorphismClasses R)
  let := (finite_simpleIsomorphismClasses (R := R) k).fintype
  let S (i : I) := (fromSkeleton (FGModuleCat.{u} R)).obj i.val
  let f : ProjectiveClass R →+ (I → ℤ) :=
    { toFun := fun g i ↦ (projectiveClassWeight k g).eval (S i)
      map_zero' := by ext; simp [Weight.eval]
      map_add' := by intros; ext; simp [Weight.eval] }
  have hfi : Function.Injective f := by
    intro x y hxy
    apply ProjectiveClass.eq_of_eval_eq_on_simples k
    intro M hM
    let i : I := ⟨toSkeleton M, M, rfl, hM⟩
    let e := fromSkeletonToSkeletonIso M
    exact ((projectiveClassWeight k x).eval_eq_of_isIso e.hom).symm.trans
      ((congrFun hxy i).trans ((projectiveClassWeight k y).eval_eq_of_isIso e.hom))
  have hb := (ha.map' f.toIntLinearMap (LinearMap.ker_eq_bot.mpr hfi)).fintype_card_le_finrank
  simpa [I] using hb

include k in
theorem projectiveFamily_bound {n : ℕ} (a : Fin n → TwoTerm R)
    (ha : LinearIndependent ℤ (fun i ↦ (a i).projectiveClass)) : n ≤ (simpleIsomorphismClasses R).ncard := by
  simpa using card_le_simple_count_of_independent_projective_classes k _ ha

include k in
theorem independent_cons_of_not_inAdd {U P : TwoTerm R} (hp : (U.directSum P).IsPresilting)
    (hn : ¬ IsInAdd P.homotopyObject U.homotopyObject) {n : ℕ} (a : Fin n → TwoTerm R) (hm : ∀ i, IsInAdd (a i).homotopyObject U.homotopyObject)
    (ha : LinearIndependent ℤ (fun i ↦ (a i).projectiveClass)) :
    LinearIndependent ℤ (fun i ↦ projectiveClass ((Fin.cons P a : Fin (n+1) → TwoTerm R) i)) := by
  classical
  rw [Fintype.linearIndependent_iff] at ha ⊢
  intro c hc
  rw [Fin.sum_univ_succ] at hc
  simp only [Fin.cons_zero, Fin.cons_succ] at hc
  have hs : ∑ i, c i.succ • (a i).projectiveClass ∈ addClassGroup U :=
    (addClassGroup U).sum_mem (fun i _ ↦ (addClassGroup U).zsmul_mem (class_mem_addClassGroup (hm i)) _)
  have hmem : c 0 • P.projectiveClass ∈ addClassGroup U :=
    (addClassGroup U).add_mem_cancel_right hs |>.mp (hc ▸ (addClassGroup U).zero_mem)
  have h₀ : c 0 = 0 := by
    cases he : c 0 with
    | ofNat m =>
      cases m with
      | zero => rfl
      | succ m =>
        rw [he] at hmem
        exact (hn (isInAdd_of_nsmul_class_mem k hp (Nat.succ_pos m) (by
          change ((m.succ : ℤ) • P.projectiveClass) ∈ addClassGroup U at hmem
          rwa [natCast_zsmul] at hmem))).elim
    | negSucc m =>
      rw [he] at hmem
      exact (hn (isInAdd_of_nsmul_class_mem k hp (Nat.succ_pos m)
        (by simpa [negSucc_zsmul] using (addClassGroup U).neg_mem hmem))).elim
  rw [h₀, zero_smul, zero_add] at hc
  intro i
  exact Fin.cases h₀ (ha _ hc) i

/-- A two-term thick subcategory, expressed on representatives in degrees −1 and 0. -/
structure IsTwoTermThick (H : TwoTerm R → Prop) : Prop where
  zero : H (contractible (ProjectiveClass.zeroProjective R))
  triangles : TwoOutOfThree H
  retracts : ∀ (P Q : TwoTerm R), Retract P.homotopyObject Q.homotopyObject → H Q → H P

set_option backward.isDefEq.respectTransparency false in
/-- Realization takes the degreewise sum to the homotopy-category biproduct. -/
@[no_expose]
noncomputable def directSumHomotopyIso (P Q : TwoTerm R) :
    (P.directSum Q).homotopyObject ≅ P.homotopyObject ⊞ Q.homotopyObject := by
  let F := realization (R := R)
  refine ⟨biprod.lift (F.map (fstDirectSum P Q)) (F.map (sndDirectSum P Q)),
    biprod.desc (F.map (inlDirectSum P Q)) (F.map (inrDirectSum P Q)), ?_, ?_⟩
  · rw [biprod.lift_desc, ← F.map_comp, ← F.map_comp, ← F.map_add, totalDirectSum, F.map_id]
    rfl
  · apply biprod.hom_ext' <;> apply biprod.hom_ext <;>
      simp only [Category.assoc, biprod.inl_desc_assoc, biprod.inr_desc_assoc,
        biprod.lift_fst, biprod.lift_snd, Category.comp_id,
        ← F.map_comp, inlDirectSum_fstDirectSum, inrDirectSum_sndDirectSum, F.map_id]
    all_goals first | exact (biprod.inl_fst).symm | exact (biprod.inr_snd).symm | skip
    · rw [show inlDirectSum P Q ≫ sndDirectSum P Q = 0 by apply Arrow.hom_ext <;> exact biprod.inl_snd]
      simp
    · rw [show inrDirectSum P Q ≫ fstDirectSum P Q = 0 by apply Arrow.hom_ext <;> exact biprod.inr_fst]
      simp

set_option backward.isDefEq.respectTransparency false in
/-- An ambient summand of a finite sum of U is a retract of an actual
two-term differential built from copies of U. -/
theorem exists_retract_copies {X : HomotopyCategory (FGModuleCat R) (ComplexShape.up ℤ)} (U : TwoTerm R)
    (hx : IsInAdd X U.homotopyObject) : ∃ n : ℕ, Nonempty (Retract X (U.copies n).homotopyObject) := by
  obtain ⟨l, hl⟩ := hx
  have factor (t : List ((X ⟶ U.homotopyObject) × (U.homotopyObject ⟶ X))) :
      ∃ (n : ℕ) (a : X ⟶ (U.copies n).homotopyObject) (b : (U.copies n).homotopyObject ⟶ X),
        a ≫ b = (t.map (fun p ↦ p.1 ≫ p.2)).sum := by
    induction t with
    | nil => exact ⟨0,0,0,by simp⟩
    | cons p t ih =>
      obtain ⟨n,a,b,hab⟩ := ih
      let e := directSumHomotopyIso U (U.copies n)
      exact ⟨n+1,biprod.lift p.1 a ≫ e.inv,e.hom ≫ biprod.desc p.2 b, by simp [biprod.lift_desc, hab]⟩
  obtain ⟨n,a,b,hab⟩ := factor l
  exact ⟨n,⟨⟨a,b,hab.trans hl⟩⟩⟩

theorem IsTwoTermThick.of_inAdd {H : TwoTerm R → Prop} (hH : IsTwoTermThick H)
    (P U : TwoTerm R) (hU : H U) (hp : IsInAdd P.homotopyObject U.homotopyObject) : H P := by
  obtain ⟨n,⟨r⟩⟩ := exists_retract_copies U hp
  apply hH.retracts P _ r
  clear r
  induction n with
  | zero => exact hH.zero
  | succ n ih =>
    exact ((hH.triangles U (U.copies (n+1)) (U.copies n) _ _ _
      (blockTriangle_distinguished U (U.copies n) 0)).1 hU).2 ih

include k in
/-- Every two-term thick subcategory has a presilting member U such that every
compatible member already belongs to add(U). The proof bounds the number of
independent projective classes by the number of simples. -/
theorem exists_maximal_presilting {H : TwoTerm R → Prop} (hH : IsTwoTermThick H) :
    ∃ U : TwoTerm R, H U ∧ U.IsPresilting ∧
      ∀ P : TwoTerm R, H P → (U.directSum P).IsPresilting → IsInAdd P.homotopyObject U.homotopyObject := by
  classical
  let family (n : ℕ) := ∃ U : TwoTerm R, H U ∧ U.IsPresilting ∧ ∃ a : Fin n → TwoTerm R,
    (∀ i, HomAdd (a i) U) ∧ LinearIndependent ℤ (fun i ↦ (a i).projectiveClass)
  let bound := (simpleIsomorphismClasses R).ncard
  have hb {n : ℕ} (h : family n) : n ≤ bound := by
    obtain ⟨_,_,_,a,_,ha⟩ := h
    exact projectiveFamily_bound k a ha
  let Z := contractible (ProjectiveClass.zeroProjective R)
  have hz : Z.IsPresilting := (shiftedHomFinrank_eq_zero_iff k Z Z).1
    (shiftedHomFinrank_contractible_target k _ _)
  have hzero : family 0 := ⟨Z,hH.zero,hz,Fin.elim0,(fun i ↦ Fin.elim0 i),linearIndependent_empty_type⟩
  let n := Nat.findGreatest family bound
  obtain ⟨U,hm,hu,a,ha,hi⟩ := (Nat.findGreatest_spec (Nat.zero_le bound) hzero : family n)
  refine ⟨U,hm,hu,?_⟩
  intro P hP hp
  by_contra hn
  have hnew : family (n+1) :=
    ⟨U.directSum P, ((hH.triangles U (U.directSum P) P _ _ _ (blockTriangle_distinguished U P 0)).1 hm).2 hP,
      hp, Fin.cons P a, Fin.cases (rightAdd U P) (fun i ↦ (ha i).trans (leftAdd U P)),
      independent_cons_of_not_inAdd k hp hn a ha hi⟩
  exact Nat.findGreatest_is_greatest (show n < n+1 by omega) (hb hnew) hnew

include k in
/-- For an E-finite algebra, one presilting U in H realizes the class of
every two-sided orthogonal member of H by an object in add(U). -/
theorem exists_generator_matching_orthogonal_classes {H : TwoTerm R → Prop} (hH : IsTwoTermThick H)
    (he : IsEFinite R) :
    ∃ U : TwoTerm R, H U ∧ U.IsPresilting ∧
      (∀ P : TwoTerm R, H P → (U.directSum P).IsPresilting → IsInAdd P.homotopyObject U.homotopyObject) ∧
      ∀ Y : TwoTerm R, H Y → Function.Surjective (homotopyBoundary U Y) →
        Function.Surjective (homotopyBoundary Y U) →
        ∃ V : TwoTerm R, V.IsPresilting ∧ V.projectiveClass = Y.projectiveClass ∧
          IsInAdd V.homotopyObject U.homotopyObject := by
  obtain ⟨U,hU,hu,hmax⟩ := exists_maximal_presilting k hH
  refine ⟨U,hU,hu,hmax,?_⟩
  intro Y hY hUY hYU
  obtain ⟨V,hV,hv,hc,hUV,hVU⟩ := exists_presilting_in_orthogonal_of_isEFinite k he
    hH.triangles hH.retracts U Y hY hUY hYU
  exact ⟨V,hv,hc,hmax V hV ((isPresilting_directSum_iff k U V).2
    ⟨hu,hv,(shiftedHomFinrank_eq_zero_iff k U V).2 hUV,(shiftedHomFinrank_eq_zero_iff k V U).2 hVU⟩)⟩

end EFiniteCharacterizations.TwoTerm
