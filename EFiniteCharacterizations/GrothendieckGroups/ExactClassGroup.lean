module

public import EFiniteCharacterizations.GrothendieckGroups.GrothendieckMonoid
public import EFiniteCharacterizations.Modules.AbelianCompositionFactors
public import Mathlib.GroupTheory.MonoidLocalization.GrothendieckGroup

/-! # The group completion of the Grothendieck monoid of an exact subcategory -/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped ZeroObject

universe u v
namespace EFiniteCharacterizations

variable {C : Type u} [Category.{v} C] [Abelian C] (T : ObjectProperty C)

/-- The group of the inherited exact structure. -/
abbrev ExactClassGroup := Algebra.GrothendieckAddGroup (GrothendieckMonoid T)

namespace ExactClassGroup
noncomputable section

def of (X : C) (hx : T X) : ExactClassGroup T :=
  Algebra.GrothendieckAddGroup.of (GrothendieckMonoid.of T X hx)

def inclusion : ExactClassGroup T →+ GrothendieckGroup C :=
  Algebra.GrothendieckAddGroup.lift (GrothendieckMonoid.dimensionMap T)

@[simp] theorem inclusion_of (X : C) (hx : T X) : inclusion T (of T X hx) = GrothendieckGroup.of X := by
  have h := Algebra.GrothendieckAddGroup.lift.symm_apply_apply (GrothendieckMonoid.dimensionMap T)
  exact (DFunLike.congr_fun h (GrothendieckMonoid.of T X hx)).trans (GrothendieckMonoid.dimensionMap_of ..)

theorem of_iso {X Y : C} (hx : T X) (hy : T Y) (e : X ≅ Y) : of T X hx = of T Y hy :=
  congrArg Algebra.GrothendieckAddGroup.of (GrothendieckMonoid.of_iso T hx hy e)

theorem of_exact {A X Q : C} (s : ExtensionSequence A X Q) (ha : T A) (hx : T X) (hq : T Q) :
    of T X hx = of T A ha + of T Q hq := by
  unfold of
  rw [GrothendieckMonoid.of_shortExact T _ s.shortExact ha hx hq,map_add]

/-- Each group element is a difference of two object classes. -/
theorem exists_difference [T.IsClosedUnderExtensions] (h₀ : T 0) (z : ExactClassGroup T) :
    ∃ (X Y : C) (hx : T X) (hy : T Y), z = of T X hx - of T Y hy := by
  induction z using AddLocalization.ind with
  | H p =>
    obtain ⟨X,hx,hX⟩ := GrothendieckMonoid.exists_representative T h₀ p.1
    obtain ⟨Y,hy,hY⟩ := GrothendieckMonoid.exists_representative T h₀ p.2.val
    refine ⟨X,Y,hx,hy,?_⟩
    simp only [of,hX,hY,Algebra.GrothendieckAddGroup.of]
    congr 1 <;> simp

/-- The coordinate subgroup generated by simple classes occurring in objects of T. -/
def supportSubgroup : AddSubgroup (GrothendieckGroup C) :=
  AddSubgroup.closure {z | ∃ (S X : C) (l : Multiset (Skeleton C)), T X ∧
    HasCompositionFactors X l ∧ toSkeleton S ∈ l ∧ z = GrothendieckGroup.of S}

private theorem class_mem_support {X : C} {l : Multiset (Skeleton C)}
    (h : HasCompositionFactors X l) (mem : ∀ (S : C), toSkeleton S ∈ l →
      GrothendieckGroup.of S ∈ supportSubgroup T) : GrothendieckGroup.of X ∈ supportSubgroup T := by
  induction h with
  | zero hz => rw [GrothendieckGroup.of_isZero hz]; exact AddSubgroup.zero_mem _
  | cons s hs hq ih =>
    rw [GrothendieckGroup.of_shortExact _ s.shortExact]
    exact AddSubgroup.add_mem _ (mem _ (Multiset.mem_cons_self ..))
      (ih (fun S hS ↦ mem S (Multiset.mem_cons_of_mem hS)))

/-- It suffices to lift each simple coordinate, additively along composition
series in T, and to identify the coordinates on the support. -/
theorem identifies_support_of_factor_sum [T.IsClosedUnderExtensions] (h₀ : T 0)
    (length : ∀ X : C, ∃ l, HasCompositionFactors X l) (score : Skeleton C → ExactClassGroup T)
    (sum : ∀ {X l} (hx : T X), HasCompositionFactors X l → (l.map score).sum = of T X hx)
    (supported : ∀ {X l} (_hx : T X), HasCompositionFactors X l →
      ∀ S : C, toSkeleton S ∈ l → inclusion T (score (toSkeleton S)) = GrothendieckGroup.of S) :
    Function.Injective (inclusion T) ∧ (inclusion T).range = supportSubgroup T := by
  classical
  let r := GrothendieckGroup.lift (fun X ↦ ((length X).choose.map score).sum) (by
    intro A hs
    obtain ⟨a,q,ha,hq,h⟩ := (length A.X₂).choose_spec.split ⟨A.f,A.g,A.zero,hs⟩
    rw [h,ha.unique (length A.X₁).choose_spec,hq.unique (length A.X₃).choose_spec,
      Multiset.map_add,Multiset.sum_add])
  have left (z : ExactClassGroup T) : r (inclusion T z) = z := by
    obtain ⟨X,Y,hx,hy,rfl⟩ := exists_difference T h₀ z
    simp only [map_sub,inclusion_of,r,GrothendieckGroup.lift_of,
      sum hx (length X).choose_spec,sum hy (length Y).choose_spec]
  refine ⟨Function.LeftInverse.injective left,le_antisymm ?_ ?_⟩
  · rintro _ ⟨z,rfl⟩
    obtain ⟨X,Y,hx,hy,rfl⟩ := exists_difference T h₀ z
    have cl {U} (hu : T U) : GrothendieckGroup.of U ∈ supportSubgroup T :=
      class_mem_support T (length U).choose_spec fun S hS ↦
        AddSubgroup.subset_closure ⟨S,U,_,hu,(length U).choose_spec,hS,rfl⟩
    simpa only [map_sub,inclusion_of] using (supportSubgroup T).sub_mem (cl hx) (cl hy)
  · rw [supportSubgroup, AddSubgroup.closure_le]
    rintro _ ⟨S,X,l,hx,h,hS,rfl⟩
    exact ⟨_,supported hx h S hS⟩

end
end ExactClassGroup
end EFiniteCharacterizations
