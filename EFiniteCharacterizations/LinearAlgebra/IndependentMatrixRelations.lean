module

public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure
public import Mathlib.Combinatorics.Matroid.Rank.ENat
public import Mathlib.LinearAlgebra.Matrix.Rank
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-! # The number of parameters needed for relations on independent coordinates -/

@[expose] public section

namespace EFiniteCharacterizations

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

/-- A field generated by t parameters cannot contain more than t
algebraically independent elements. -/
private theorem independent_card_le_generators {ι : Type*} [Fintype ι]
    (x : ι → K) (hx : AlgebraicIndependent k x) (s : Finset K)
    (h : ∀ i, x i ∈ IntermediateField.adjoin k (s : Set K)) : Fintype.card ι ≤ s.card := by
  let M := AlgebraicIndependent.matroid k K
  have hi : M.Indep (Set.range x) := AlgebraicIndependent.matroid_indep_iff.mpr hx.to_subtype_range
  have hcl : Set.range x ⊆ M.closure s := by
    rintro _ ⟨i,rfl⟩
    rw [AlgebraicIndependent.matroid_closure_eq]
    apply (IntermediateField.isAlgebraic_adjoin_iff (F := k) (s := (s : Set K))).mp
    exact isAlgebraic_algebraMap (A := K) (⟨x i,h i⟩ : IntermediateField.adjoin k (s : Set K))
  have hc := (M.eRk_mono hcl).trans ((M.eRk_closure_eq _).le.trans (M.eRk_le_encard _))
  rw [hi.eRk_eq_encard, hx.injective.encard_range] at hc
  simpa using hc

/-- Independent rows satisfy linear equations over a field of parameters.
Each independent equation on each row costs one parameter. -/
theorem rank_mul_le_parameters {i j l : Type*} [Fintype i] [Fintype j] [Fintype l]
    (x : i × j → K) (hx : AlgebraicIndependent k x) (s : Finset K)
    (A : Matrix l j (IntermediateField.adjoin k (s : Set K)))
    (h : ∀ a b, ∑ c, (A b c : K) * x (a,c) = 0) :
    Fintype.card i * A.rank ≤ s.card := by
  classical
  let E := IntermediateField.adjoin k (s : Set K)
  let L (a : i) : (j → E) →ₗ[E] K := (Pi.basisFun E j).constr E (fun c ↦ x (a,c))
  let W a := LinearMap.range (L a)
  have hd a : Module.finrank E (W a) + A.rank ≤ Fintype.card j := by
    have hker : Submodule.span E (Set.range A.row) ≤ LinearMap.ker (L a) := by
      apply Submodule.span_le.mpr
      rintro _ ⟨b,rfl⟩
      change L a (A.row b) = 0
      simpa [L,Module.Basis.constr_apply_fintype,Algebra.smul_def] using h a b
    have hr := Submodule.finrank_mono hker
    rw [← Matrix.rank_eq_finrank_span_row] at hr
    have he := (L a).finrank_range_add_finrank_ker
    rw [Module.finrank_pi] at he
    exact (Nat.add_le_add_left hr _).trans he.le
  let b a := Module.finBasis E (W a)
  let t a := Finset.univ.image (fun c ↦ ((b a c).val : K))
  let u := s ∪ Finset.univ.biUnion t
  let H := IntermediateField.adjoin k (u : Set K)
  have hE : E ≤ H := IntermediateField.adjoin.mono _ _ _ (by exact_mod_cast Finset.subset_union_left)
  have hmem a c : (b a c).val ∈ H :=
    IntermediateField.subset_adjoin k _ (Finset.mem_union_right _ (Finset.mem_biUnion.mpr
      ⟨a,Finset.mem_univ _,Finset.mem_image.mpr ⟨c,Finset.mem_univ _,rfl⟩⟩))
  have hc := independent_card_le_generators x hx u (fun ⟨a,j⟩ ↦ by
    have hw : x (a,j) ∈ W a := ⟨Pi.basisFun E _ j,by simp [L]⟩
    let y : W a := ⟨_,hw⟩
    have he := congrArg (W a).subtype ((b a).sum_repr y)
    rw [map_sum] at he
    change x (a,j) ∈ H
    rw [← show (W a).subtype y = x (a,j) from rfl,← he]
    apply H.sum_mem
    intro v _
    exact H.mul_mem (hE ((b a).repr y v).property) (hmem a v))
  rw [Fintype.card_prod] at hc
  have hsum : (∑ a, (t a).card) + Fintype.card i * A.rank ≤ Fintype.card i * Fintype.card j := by
    have he a : (t a).card + A.rank ≤ Fintype.card j := by
      apply le_trans _ (hd a)
      apply Nat.add_le_add_right
      simpa only [Finset.card_univ,Fintype.card_fin] using (Finset.card_image_le (s := Finset.univ) (f := fun c ↦ ((b a c).val : K)))
    simpa [Finset.sum_add_distrib] using Finset.sum_le_sum (fun a (_ : a ∈ Finset.univ) ↦ he a)
  have hu := (Finset.card_union_le s (Finset.univ.biUnion t)).trans
    (Nat.add_le_add_left (Finset.card_biUnion_le (s := Finset.univ) (t := t)) _)
  dsimp only [u] at hc
  omega

end EFiniteCharacterizations
