module

public import EFiniteCharacterizations.Stability.SubmodulePolytopes
public import Mathlib.Analysis.Convex.Extreme

/-! # The integer grid for normalized submodule polytopes -/

@[expose] public section
open CategoryTheory CategoryTheory.Limits
open scoped ModuleCat.Algebra TensorProduct

universe u v
namespace EFiniteCharacterizations

variable (k : Type u) [Field k] {R : Type u} [Ring R] [Algebra k R] [Module.Finite k R]
  [IsNoetherianRing R] {I : Type v}

include k in
private theorem epi_regular_of_indecomposable (P : FiniteProjective R) (hp : Indecomposable P.val) :
    ∃ q : FGModuleCat.of R R ⟶ P.val, Epi q := by
  have := IsArtinianRing.of_finite k R
  obtain ⟨S,p,hs,hp'⟩ := FGModuleCat.exists_simple_quotient hp.1
  have : Nontrivial S := not_subsingleton_iff_nontrivial.mp
    (fun h ↦ Simple.not_isZero S ((FGModuleCat.isZero_iff_subsingleton S).2 h))
  obtain ⟨x,hx⟩ := exists_ne (0 : S)
  let f : FGModuleCat.of R R ⟶ S := FGModuleCat.ofHom (LinearMap.toSpanSingleton R _ x)
  have hf : f ≠ 0 := by
    intro hz
    have h := congrArg (fun g : FGModuleCat.of R R ⟶ S ↦ g.hom.hom 1) hz
    change (1 : R) • x = 0 at h
    exact hx ((one_smul R x).symm.trans h)
  have := epi_of_nonzero_to_simple hf
  let := P.property
  let : Module.Projective R (FGModuleCat.of R R) := inferInstanceAs (Module.Projective R R)
  obtain ⟨a,ha⟩ := FGModuleCat.exists_lift_of_projective f p
  obtain ⟨b,hb⟩ := FGModuleCat.exists_lift_of_projective p f
  have hpne : p ≠ 0 := fun hz ↦ hf (by rw [← hb,hz,comp_zero])
  have := FGModuleCat.isIso_of_quotient_eq_self hp p hpne (a ≫ b) (by rw [Category.assoc,hb,ha])
  exact ⟨b,epi_of_epi a b⟩

private theorem grid_coordinate (P : FiniteProjective R) (hp : Indecomposable P.val)
    {M : FGModuleCat.{u} R} (hb : IsBrick M) (U : Submodule R (M.obj : Type u))
    (hu : EndInvariant (M := M) U) :
    ∃ n ≤ endolength k M, homFinrank k P.val (FGModuleCat.of R U) = homFinrank k M M * n := by
  obtain ⟨n,_,hn⟩ := hom_dimension_of_endInvariant k hb P.val hu
  obtain ⟨q,hq⟩ := epi_regular_of_indecomposable k P hp
  let ev : (P.val ⟶ FGModuleCat.of R U) →ₗ[k] (M.obj : Type u) :=
    { toFun := fun f ↦ (f.hom.hom (q.hom.hom 1)).val
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  have hinj : Function.Injective ev := by
    intro f g he
    apply (cancel_epi q).1
    apply FGModuleCat.hom_ext
    apply LinearMap.ext
    intro z
    have eq : (q ≫ f).hom.hom 1 = (q ≫ g).hom.hom 1 := Subtype.ext he
    have h := congrArg (fun t : U ↦ z • t) eq
    simpa only [← map_smul,smul_eq_mul,mul_one] using h
  have := Module.Finite.trans (R := k) R (M.obj : Type u)
  have hbound := LinearMap.finrank_le_finrank_of_injective (f := ev) hinj
  rw [← homFinrank_eq_finrank,hn] at hbound
  have hpos := (homFinrank_pos_iff k M M).2 ⟨𝟙 _,fun h ↦ hb.1 ((IsZero.iff_id_eq_zero _).2 h)⟩
  exact ⟨n,(Nat.le_div_iff_mul_le hpos).2 ((Nat.mul_comm ..) ▸ hbound),hn⟩

/-- The real linear map taking a module class to its projective Hom
coordinates divided by the ground dimension of the brick endomorphism ring. -/
noncomputable def normalizedCoordinates (Q : I → FiniteProjective R) (M : FGModuleCat.{u} R) :
    RealModuleClassSpace R →ₗ[ℝ] (I → ℝ) :=
  (homFinrank k M M : ℝ)⁻¹ • LinearMap.pi fun i ↦
    (((Int.castAddHom ℝ).comp (projectiveClassWeight k (ProjectiveClass.of (Q i)))).toIntLinearMap).liftBaseChange ℝ

/-- The normalized polytope in the coordinates of the chosen projectives. -/
noncomputable def normalizedSubmodulePolytope (Q : I → FiniteProjective R) (M : FGModuleCat.{u} R) :
    Set (I → ℝ) := normalizedCoordinates k Q M '' submodulePolytope M

/-- In these coordinates the generators are precisely the normalized Hom
dimension vectors of subobjects. -/
theorem normalizedSubmodulePolytope_eq_hull (Q : I → FiniteProjective R) (M : FGModuleCat.{u} R) :
    normalizedSubmodulePolytope k Q M = convexHull ℝ
      {v | ∃ (U : FGModuleCat.{u} R) (j : U ⟶ M), Mono j ∧
        ∀ i, v i = (homFinrank k (Q i).val U : ℝ) / (homFinrank k M M : ℝ)} := by
  rw [normalizedSubmodulePolytope,submodulePolytope,LinearMap.image_convexHull]
  apply congrArg (convexHull ℝ)
  have coord (U : FGModuleCat.{u} R) (i : I) :
      normalizedCoordinates k Q M ((1 : ℝ) ⊗ₜ[ℤ] GrothendieckGroup.of U) i =
        (homFinrank k (Q i).val U : ℝ) / (homFinrank k M M : ℝ) := by
    let := (Q i).property
    have h := projectiveHomWeight_eval k (Q i).val U
    change (projectiveHomWeight k (Q i).val) _ = _ at h
    simp [normalizedCoordinates,projectiveClassWeight_of,div_eq_inv_mul,h]
  ext v
  constructor
  · rintro ⟨_,⟨_,⟨U,j,hj,rfl⟩,rfl⟩,rfl⟩
    exact ⟨U,j,hj,coord U⟩
  · rintro ⟨U,j,hj,hv⟩
    exact ⟨_,⟨_,⟨U,j,hj,rfl⟩,rfl⟩,funext fun i ↦ (coord U i).trans (hv i).symm⟩

/-- The normalized polytope is generated by a subset of the integer grid. -/
theorem normalizedSubmodulePolytope_grid_hull (Q : I → FiniteProjective R) (hQ : ∀ i, Indecomposable (Q i).val)
    {M : FGModuleCat.{u} R} (hb : IsBrick M) :
    ∃ s : Set (I → Fin (endolength k M + 1)), normalizedSubmodulePolytope k Q M =
      convexHull ℝ ((fun v i ↦ ((v i).val : ℝ)) '' s) := by
  classical
  let F := normalizedCoordinates k Q M
  let H := (fun z ↦ (1 : ℝ) ⊗ₜ[ℤ] z) '' invariantSubmoduleProfile M
  let embed (v : I → Fin (endolength k M + 1)) (i : I) := ((v i).val : ℝ)
  refine ⟨embed ⁻¹' (F '' H),?_⟩
  rw [normalizedSubmodulePolytope,submodulePolytope_eq_invariant_hull k hb,LinearMap.image_convexHull]
  apply congrArg (convexHull ℝ)
  refine Set.Subset.antisymm ?_ (Set.image_preimage_subset ..)
  rintro _ ⟨_,⟨_,⟨U,hu,rfl⟩,rfl⟩,rfl⟩
  choose n hn he using fun i ↦ grid_coordinate k (Q i) (hQ i) hb U hu
  let v (i : I) : Fin (endolength k M + 1) := ⟨n i,Nat.lt_succ_of_le (hn i)⟩
  have hpos := (homFinrank_pos_iff k M M).2 ⟨𝟙 _,fun h ↦ hb.1 ((IsZero.iff_id_eq_zero _).2 h)⟩
  have eq : embed v = F ((1 : ℝ) ⊗ₜ[ℤ] GrothendieckGroup.of (FGModuleCat.of R U)) := by
    funext i
    let := (Q i).property
    have coord := projectiveHomWeight_eval k (Q i).val (FGModuleCat.of R U)
    change (projectiveHomWeight k (Q i).val) _ = _ at coord
    simp [F,normalizedCoordinates,embed,v,projectiveClassWeight_of,coord,he i,
      (show (homFinrank k M M : ℝ) ≠ 0 by exact_mod_cast hpos.ne')]
  exact ⟨v,⟨_,⟨_,⟨U,hu,rfl⟩,rfl⟩,eq.symm⟩,eq⟩

theorem normalizedSubmodulePolytope_vertices (Q : I → FiniteProjective R) (hQ : ∀ i, Indecomposable (Q i).val)
    {M : FGModuleCat.{u} R} (hb : IsBrick M) :
    (normalizedSubmodulePolytope k Q M).extremePoints ℝ ⊆
      Set.range (fun (v : I → Fin (endolength k M + 1)) i ↦ ((v i).val : ℝ)) := by
  obtain ⟨s,hs⟩ := normalizedSubmodulePolytope_grid_hull k Q hQ hb
  rw [hs]
  exact extremePoints_convexHull_subset.trans (Set.image_subset_range ..)

theorem normalizedSubmodulePolytope_count [Fintype I] (Q : I → FiniteProjective R)
    (hQ : ∀ i, Indecomposable (Q i).val) (r : ℕ) :
    let C := {P | ∃ M : FGModuleCat.{u} R, IsBrick M ∧ endolength k M = r ∧ normalizedSubmodulePolytope k Q M = P}
    C.Finite ∧ C.ncard ≤ 2 ^ ((r + 1) ^ Fintype.card I) := by
  classical
  dsimp only
  let f (s : Set (I → Fin (r+1))) := convexHull ℝ ((fun v i ↦ ((v i).val : ℝ)) '' s)
  have h : {P | ∃ M : FGModuleCat.{u} R, IsBrick M ∧ endolength k M = r ∧ normalizedSubmodulePolytope k Q M = P} ⊆ Set.range f := by
    rintro _ ⟨M,hb,rfl,rfl⟩
    obtain ⟨s,hs⟩ := normalizedSubmodulePolytope_grid_hull k Q hQ hb
    exact ⟨s,hs.symm⟩
  exact ⟨(Set.finite_range f).subset h,(Set.ncard_le_ncard h (Set.finite_range f)).trans
    (by simpa [← Nat.card_coe_set_eq,Nat.card_eq_fintype_card,Fintype.card_fun] using Finite.card_range_le f)⟩

end EFiniteCharacterizations
