module

public import EFiniteCharacterizations.Stability.RealWalls
public import EFiniteCharacterizations.Presentations.ProjectiveRankBound
public import EFiniteCharacterizations.Presentations.PrecompositionSummands
public import EFiniteCharacterizations.LargeModules.LargePerpendicular
public import Mathlib.Analysis.Convex.Intrinsic
public import Mathlib.Geometry.Convex.Cone.Pointed
public import Mathlib.Topology.Algebra.Module.ModuleTopology

/-! # Stable points of real brick walls -/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace EFiniteCharacterizations

variable (k : Type u) [Field k] {R : Type u} [Ring R] [Algebra k R] [Module.Finite k R]
  [IsNoetherianRing R]

/-- The total weight vanishes and every proper nonzero submodule has strictly
negative weight. -/
def RealStableAt (v : RealProjectiveSpace R) (X : FGModuleCat.{u} R) : Prop :=
  ¬ IsZero X ∧ realEulerEvaluation k (GrothendieckGroup.of X) v = 0 ∧
    ∀ z ∈ properSubobjectClasses X, realEulerEvaluation k z v < 0

theorem realStableAt_integral (g : ProjectiveClass R) (X : FGModuleCat.{u} R) :
    RealStableAt k (realProjectiveClass R g) X ↔ (projectiveClassWeight k g).IsStable X := by
  simp only [RealStableAt,realEulerEvaluation_integral,Int.cast_eq_zero,Int.cast_lt_zero]
  constructor
  · rintro ⟨hx,hz,hs⟩
    exact ⟨hx,hz,fun i hi hn hp ↦ hs _ ⟨_,i,hi,hn,hp,rfl⟩⟩
  · rintro ⟨hx,hz,hs⟩
    refine ⟨hx,hz,?_⟩
    rintro _ ⟨U,i,hi,hn,hp,rfl⟩
    exact hs i hn hp

theorem RealStableAt.mem_wall {v : RealProjectiveSpace R} {X : FGModuleCat.{u} R}
    (h : RealStableAt k v X) : v ∈ realStabilityWall k X :=
  ⟨h.2.1,fun z hz ↦ (h.2.2 z hz).le⟩

theorem real_eval_subobject_nonpos {v : RealProjectiveSpace R} {X U : FGModuleCat.{u} R}
    (h : v ∈ realStabilityWall k X) (i : U ⟶ X) [Mono i] :
    realEulerEvaluation k (GrothendieckGroup.of U) v ≤ 0 := by
  by_cases hn : IsZero U
  · rw [GrothendieckGroup.of_isZero hn]
    suffices hz : ∀ w : RealProjectiveSpace R, realEulerEvaluation k 0 w = 0 from (hz v).le
    intro w
    induction w using TensorProduct.inductionOn with
    | tmul => simp [realEulerEvaluation_tmul]
    | add a b ha hb => simp [ha,hb]
  by_cases hi : IsIso i
  · rw [GrothendieckGroup.of_eq_of_iso (asIso i)]
    exact h.1.le
  exact h.2 _ ⟨_,i,inferInstance,hn,hi,rfl⟩

/-- Real stability is determined by the semistable objects and their
submodule inclusions. -/
theorem realStableAt_iff_no_proper_semistable (v : RealProjectiveSpace R) (X : FGModuleCat.{u} R) :
    RealStableAt k v X ↔ ¬ IsZero X ∧ v ∈ realStabilityWall k X ∧
      ∀ (U : FGModuleCat.{u} R) (i : U ⟶ X) [Mono i], ¬ IsZero U → ¬ IsIso i →
        v ∉ realStabilityWall k U := by
  constructor
  · intro h
    exact ⟨h.1,h.mem_wall k,fun U i hi hn hp hw ↦
      (h.2.2 _ ⟨U,i,hi,hn,hp,rfl⟩).ne hw.1⟩
  · rintro ⟨hn,hw,hs⟩
    refine ⟨hn,hw.1,?_⟩
    rintro _ ⟨U,i,hi,hu,hp,rfl⟩
    refine (real_eval_subobject_nonpos k hw i).lt_of_ne fun hz ↦ hs U i hu hp ⟨hz,?_⟩
    rintro _ ⟨V,j,hj,_,_,rfl⟩
    exact real_eval_subobject_nonpos k hw (j ≫ i)

/-- Two modules with equal walls and nonempty stable loci are stable at
exactly the same weights. -/
theorem realStableAt_of_equal_walls {v w : RealProjectiveSpace R} {X Y : FGModuleCat.{u} R}
    (hx : RealStableAt k v X) (hy : RealStableAt k w Y)
    (hw : realStabilityWall k X = realStabilityWall k Y) : RealStableAt k v Y := by
  have hvY : v ∈ realStabilityWall k Y := hw ▸ hx.mem_wall k
  have hwX : w ∈ realStabilityWall k X := hw.symm ▸ hy.mem_wall k
  let ratio z := realEulerEvaluation k z w / realEulerEvaluation k z v
  obtain ⟨t,ht⟩ := ((finite_properSubobjectClasses k X).image ratio).bddAbove
  have hp : t • v - w ∈ realStabilityWall k X := by
    constructor
    · rw [map_sub,realEulerEvaluation_smul,hx.2.1,hwX.1,mul_zero,sub_zero]
    · intro z hz
      rw [map_sub,realEulerEvaluation_smul,sub_nonpos]
      exact (div_le_iff_of_neg (hx.2.2 z hz)).mp (ht (Set.mem_image_of_mem ratio hz))
  have hpY : t • v - w ∈ realStabilityWall k Y := hw ▸ hp
  refine ⟨hy.1,hvY.1,fun z hz ↦ (hvY.2 z hz).lt_of_ne fun he ↦ ?_⟩
  have hle := hpY.2 z hz
  rw [map_sub,realEulerEvaluation_smul,he,mul_zero,zero_sub,neg_nonpos] at hle
  exact (hy.2.2 z hz).not_ge hle

variable [IsArtinianRing R]

/-- The uniqueness clause at just one real weight for each brick already
implies E-finiteness over an arbitrary field. -/
theorem isEFinite_of_unique_real_stable_weights
    (h : ∀ X : FGModuleCat.{u} R, IsBrick X → ∃ v : RealProjectiveSpace R,
      RealStableAt k v X ∧ ∀ Y : FGModuleCat.{u} R, RealStableAt k v Y → Nonempty (X ≅ Y)) :
    IsEFinite R := by
  apply (isEFinite_iff_wall_inj k).2
  intro X Y hx hy he
  obtain ⟨_,hX,hu⟩ := h X hx
  obtain ⟨_,hY,_⟩ := h Y hy
  exact hu _ (realStableAt_of_equal_walls k hX hY he)

/-- The cone of a presilting complex is generated by the classes of its
summands. Taking summands of finite sums gives the same cone. Contractible
summands contribute zero. -/
def TwoTerm.gVectorCone (P : TwoTerm R) : PointedCone ℝ (RealProjectiveSpace R) :=
  PointedCone.hull ℝ {v | ∃ Q : TwoTerm R, IsInAdd Q.asArrow P.asArrow ∧ v = realProjectiveClass R Q.projectiveClass}

local instance : TopologicalSpace (RealProjectiveSpace R) := moduleTopology ℝ _

/-- Every brick wall contains a codimension-one fan cone, and the brick is
the unique stable isomorphism class throughout its relative interior. -/
def BrickWallFaces : Prop :=
  ∀ X : FGModuleCat.{u} R, IsBrick X → ∃ P : TwoTerm R, P.IsPresilting ∧
    Module.finrank ℝ (Submodule.span ℝ (P.gVectorCone : Set (RealProjectiveSpace R))) + 1 =
      Module.finrank ℝ (RealProjectiveSpace R) ∧
    (P.gVectorCone : Set (RealProjectiveSpace R)) ⊆ realStabilityWall k X ∧
    ∀ v ∈ intrinsicInterior ℝ (P.gVectorCone : Set (RealProjectiveSpace R)), RealStableAt k v X ∧
      ∀ Y : FGModuleCat.{u} R, RealStableAt k v Y → Nonempty (X ≅ Y)

omit [IsNoetherianRing R] [IsArtinianRing R] in
include k in
theorem TwoTerm.gVectorCone_interior_nonempty (P : TwoTerm R) :
    (intrinsicInterior ℝ (P.gVectorCone : Set (RealProjectiveSpace R))).Nonempty := by
  have := (realProjectiveSpace_rank_bound (R := R) k).1
  have : IsModuleTopology ℝ (RealProjectiveSpace R) := ⟨rfl⟩
  have : ContinuousAdd (RealProjectiveSpace R) := ModuleTopology.continuousAdd ℝ _
  have : ContinuousSMul ℝ (RealProjectiveSpace R) := ModuleTopology.continuousSMul ℝ _
  let e := (Module.finBasis ℝ (RealProjectiveSpace R)).equivFun
  let φ : RealProjectiveSpace R ≃ᴬ[ℝ] (Fin (Module.finrank ℝ (RealProjectiveSpace R)) → ℝ) :=
    { e.toAffineEquiv with
      continuous_toFun := IsModuleTopology.continuous_of_linearMap e.toLinearMap
      continuous_invFun := IsModuleTopology.continuous_of_linearMap e.symm.toLinearMap }
  let s := (P.gVectorCone : Set (RealProjectiveSpace R))
  have hc : Convex ℝ (φ '' s) := P.gVectorCone.convex.linear_image e.toLinearMap
  have hn : (φ '' s).Nonempty := (Set.nonempty_of_mem P.gVectorCone.zero_mem).image φ
  have h := hn.intrinsicInterior hc
  rwa [φ.intrinsicInterior_image,Set.image_nonempty] at h

/-- The wall-face condition implies E-finiteness over every field. -/
theorem isEFinite_of_wall_face (h : BrickWallFaces (R := R) k) : IsEFinite R := by
  apply isEFinite_of_unique_real_stable_weights k
  intro X hX
  obtain ⟨P,_,_,_,hu⟩ := h X hX
  obtain ⟨v,hv⟩ := P.gVectorCone_interior_nonempty k
  exact ⟨v,hu v hv⟩

end EFiniteCharacterizations
