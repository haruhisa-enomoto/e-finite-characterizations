module

public import EFiniteCharacterizations.Modules.Bricks
public import EFiniteCharacterizations.Stability.SubmoduleWeights

/-! # Torsion pairs and numerical disjointness -/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v

namespace EFiniteCharacterizations

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- The two classes are Hom-orthogonal and give a short exact decomposition
of every object. -/
def IsTorsionPair (T F : ObjectProperty C) : Prop :=
  (∀ {X Y : C} (f : X ⟶ Y), T X → F Y → f = 0) ∧
    ∀ X : C, ∃ (L Q : C) (i : L ⟶ X) (p : X ⟶ Q) (w : i ≫ p = 0),
      T L ∧ F Q ∧ (ShortComplex.mk i p w).ShortExact

/-- No nonzero objects on opposite sides of any torsion pair share a class. -/
def NumericallyDisjointTorsionPairs (C : Type u) [Category.{v} C] [Abelian C] : Prop :=
  ∀ T F : ObjectProperty C, IsTorsionPair T F → ∀ X Y : C,
    T X → F Y → ¬ IsZero X → ¬ IsZero Y → GrothendieckGroup.of X ≠ GrothendieckGroup.of Y

def rightHomOrthogonal (B : C) : ObjectProperty C :=
  fun Y ↦ ∀ f : B ⟶ Y, f = 0

def leftHomOrthogonal (F : ObjectProperty C) : ObjectProperty C :=
  fun X ↦ ∀ Y, F Y → ∀ f : X ⟶ Y, f = 0

theorem leftHomOrthogonal_of_epi {F : ObjectProperty C} {A B : C}
    (p : A ⟶ B) [Epi p] (h : leftHomOrthogonal F A) : leftHomOrthogonal F B := by
  intro Y hY f
  exact (cancel_epi p).mp (by simpa using h Y hY (p ≫ f))

theorem leftHomOrthogonal_of_shortExact {F : ObjectProperty C} {S : ShortComplex C}
    (hs : S.ShortExact) (h₁ : leftHomOrthogonal F S.X₁) (h₃ : leftHomOrthogonal F S.X₃) :
    leftHomOrthogonal F S.X₂ := by
  intro Y hY f
  let := hs.epi_g
  obtain ⟨g, hg⟩ := CokernelCofork.IsColimit.desc' hs.exact.gIsCokernel f (h₁ Y hY _)
  simpa [h₃ Y hY g] using hg.symm

variable {R : Type u} [Ring R] [IsNoetherianRing R]

theorem shortExact_of_range_ker {A X Q : FGModuleCat.{u} R}
    (i : A ⟶ X) (p : X ⟶ Q) (hi : Function.Injective i.hom.hom)
    (hp : Function.Surjective p.hom.hom) (he : i.hom.hom.range = p.hom.hom.ker) :
    ∃ w : i ≫ p = 0, (ShortComplex.mk i p w).ShortExact := by
  have w : i ≫ p = 0 := by
    apply FGModuleCat.hom_ext
    ext x
    exact he.le ⟨x, rfl⟩
  let S := ShortComplex.mk i p w
  let H := forget₂ (FGModuleCat.{u} R) (ModuleCat.{u} R)
  have hex : (S.map H).Exact := ShortComplex.Exact.moduleCat_of_range_eq_ker i.hom p.hom he
  exact ⟨w, ShortComplex.ShortExact.mk' ((S.exact_map_iff_of_faithful H).mp hex)
    ((FGModuleCat.mono_iff_injective i).2 hi) ((FGModuleCat.epi_iff_surjective p).2 hp)⟩

/-- The common right Hom-orthogonal of a collection of modules is the
torsion-free half of the torsion pair generated by the collection. -/
theorem isTorsionPair_generatedBy (A₀ : ObjectProperty (FGModuleCat.{u} R)) :
    let F : ObjectProperty _ := fun Y ↦ ∀ B, A₀ B → rightHomOrthogonal B Y
    IsTorsionPair (leftHomOrthogonal F) F := by
  classical
  let F : ObjectProperty _ := fun Y ↦ ∀ B, A₀ B → rightHomOrthogonal B Y
  let T := leftHomOrthogonal F
  refine ⟨fun f h hY ↦ h _ hY f, fun X ↦ ?_⟩
  let A := (X.obj : Type u)
  let s := {U : Submodule R A | T (FGModuleCat.of R U)}
  have hs : s.Nonempty := by
    refine ⟨⊥, ?_⟩
    intro Y _ f
    exact (FGModuleCat.isZero_iff_subsingleton _).2 (inferInstanceAs (Subsingleton (⊥ : Submodule R A))) |>.eq_of_src f 0
  obtain ⟨U, hU, hmax⟩ := wellFounded_gt.has_min s hs
  have hQ : F (FGModuleCat.of R (A ⧸ U)) := by
    intro B hB f
    let l : (B.obj : Type u) →ₗ[R] A ⧸ U := f.hom.hom
    let V := l.range.comap U.mkQ
    have huv : U ≤ V := by
      intro x hx
      change U.mkQ x ∈ l.range
      rw [show U.mkQ x = 0 from (Submodule.Quotient.mk_eq_zero U).2 hx]
      exact l.range.zero_mem
    let i := FGModuleCat.ofHom (Submodule.inclusion huv)
    let p := FGModuleCat.ofHom ((U.mkQ.comp V.subtype).codRestrict l.range fun x ↦ x.property)
    have hp : Function.Surjective p.hom.hom := by
      intro y
      obtain ⟨x, hx⟩ := U.mkQ_surjective y.val
      exact ⟨⟨x, show U.mkQ x ∈ l.range from hx.symm ▸ y.property⟩, Subtype.ext hx⟩
    have he : i.hom.hom.range = p.hom.hom.ker := by
      ext x
      constructor
      · rintro ⟨z, rfl⟩
        exact Subtype.ext ((Submodule.Quotient.mk_eq_zero U).2 z.property)
      · intro hz
        exact ⟨⟨x.val, (Submodule.Quotient.mk_eq_zero U).1 (congrArg Subtype.val hz)⟩, Subtype.ext rfl⟩
    obtain ⟨w, hse⟩ := shortExact_of_range_ker i p (Submodule.inclusion_injective huv) hp he
    let e := FGModuleCat.ofHom l.rangeRestrict
    have : Epi e := (FGModuleCat.epi_iff_surjective _).2 (fun ⟨_, b, hb⟩ ↦ ⟨b, Subtype.ext hb⟩)
    have hr : T (FGModuleCat.of R l.range) := leftHomOrthogonal_of_epi e (fun _ hY ↦ hY B hB)
    have hV : V ∈ s := leftHomOrthogonal_of_shortExact hse hU hr
    have hvu : V ≤ U := Classical.byContradiction fun hn ↦ hmax V hV (lt_of_le_not_ge huv hn)
    apply FGModuleCat.hom_ext
    apply LinearMap.ext
    intro b
    obtain ⟨x, hx⟩ := U.mkQ_surjective (l b)
    exact hx.symm.trans ((Submodule.Quotient.mk_eq_zero U).2 (hvu (show x ∈ V from (show U.mkQ x ∈ l.range from ⟨b, hx.symm⟩))))
  let i : FGModuleCat.of R U ⟶ X := FGModuleCat.ofHom U.subtype
  let p : X ⟶ FGModuleCat.of R (A ⧸ U) := FGModuleCat.ofHom U.mkQ
  obtain ⟨w, he⟩ := shortExact_of_range_ker i p Subtype.val_injective U.mkQ_surjective
    ((Submodule.range_subtype U).trans (Submodule.ker_mkQ U).symm)
  exact ⟨_, _, i, p, w, hU, hQ, he⟩

/-- The torsion pair generated by one module. -/
theorem isTorsionPair_generated (B : FGModuleCat.{u} R) :
    IsTorsionPair (leftHomOrthogonal (rightHomOrthogonal B)) (rightHomOrthogonal B) := by
  simpa using isTorsionPair_generatedBy (fun X ↦ X = B)

theorem numericallyDisjointTorsionPairs_of_equalClassHom [IsArtinianRing R]
    (h : EqualClassHom (FGModuleCat.{u} R)) : NumericallyDisjointTorsionPairs (FGModuleCat.{u} R) := by
  intro T F hp X Y hX hY hn _ he
  obtain ⟨f, hf⟩ := h X Y he (FGModuleCat.class_ne_zero hn)
  exact hf (hp.1 f hX hY)

theorem equalClassHom_of_numericallyDisjointTorsionPairs
    (h : NumericallyDisjointTorsionPairs (FGModuleCat.{u} R)) : EqualClassHom (FGModuleCat.{u} R) := by
  intro X Y he hn
  by_contra! hzero
  have hX : ¬ IsZero X := fun hz ↦ hn (GrothendieckGroup.of_isZero hz)
  have hY : ¬ IsZero Y := fun hz ↦ hn (he.trans (GrothendieckGroup.of_isZero hz))
  exact h _ _ (isTorsionPair_generated X) X Y (fun _ hF ↦ hF) hzero hX hY he

theorem numericallyDisjointTorsionPairs_iff_equalClassHom [IsArtinianRing R] :
    NumericallyDisjointTorsionPairs (FGModuleCat.{u} R) ↔ EqualClassHom (FGModuleCat.{u} R) :=
  ⟨equalClassHom_of_numericallyDisjointTorsionPairs, numericallyDisjointTorsionPairs_of_equalClassHom⟩

end EFiniteCharacterizations
