module

public import Mathlib.RingTheory.Artinian.Module
public import Mathlib.LinearAlgebra.FiniteDimensional.Basic
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.Tactic.Ring

/-! # A Fitting idempotent in a finite-dimensional endomorphism algebra -/

@[expose] public section

namespace EFiniteCharacterizations

private theorem fitting_in_commRing {S : Type*} [CommRing S] [IsArtinianRing S] (x : S) :
    ∃ (e c : S) (n : ℕ), e * e = e ∧ x ^ n * e = 0 ∧ e + x*c = 1 := by
  obtain ⟨n,b,hb⟩ := IsArtinian.exists_pow_succ_smul_dvd x (1 : S)
  have h : x ^ n * (x*b) = x ^ n := by simpa only [smul_eq_mul, mul_one, pow_succ, mul_assoc] using hb
  have hj (m : ℕ) : x ^ n * (x*b)^m = x ^ n := by
    induction m with
    | zero => simp
    | succ m ih => rw [pow_succ, ← mul_assoc, ih, h]
  let j := (x*b)^(n+1)
  have he : x^n * (1-j) = 0 := by rw [mul_sub, mul_one, hj, sub_self]
  have hj' : j * (1-j) = 0 := by
    change (x*b)^(n+1) * (1-j) = 0
    rw [pow_succ, mul_pow]
    calc
      x^n * b^n * (x*b) * (1-j) = (x^n*(1-j))*(b^n*(x*b)) := by ring
      _ = 0 := by rw [he,zero_mul]
  refine ⟨1-j, b*(x*b)^n, n, ?_,he,?_⟩
  · rw [sub_mul, one_mul, hj', sub_zero]
  · dsimp [j]
    rw [pow_succ]
    ring

/-- Fitting's idempotent and a commuting partial inverse in the algebra
generated by one endomorphism of a finite-dimensional algebra. -/
theorem exists_fitting_idempotent (k : Type*) [Field k] {A : Type*} [Ring A] [Algebra k A]
    [Module.Finite k A] (a : A) :
    ∃ (e c : A) (n : ℕ), e * e = e ∧ e * a ^ n = 0 ∧ c*a = a*c ∧ e + a*c = 1 := by
  let S := Algebra.adjoin k ({a} : Set A)
  let x : S := ⟨a, Algebra.self_mem_adjoin_singleton k a⟩
  have : IsMulCommutative S := Algebra.isMulCommutative_adjoin k (Set.pairwise_singleton _ _)
  let : CommRing S := { (inferInstance : Ring S) with mul_comm := mul_comm' }
  have : Module.Finite k S := Module.Finite.of_injective S.val.toLinearMap Subtype.val_injective
  let : IsArtinianRing S := isArtinian_of_tower k (inferInstance : IsArtinian k S)
  obtain ⟨e,c,n,h₁,h₂,h₃⟩ := fitting_in_commRing x
  exact ⟨e,c,n,congrArg Subtype.val h₁,congrArg Subtype.val ((mul_comm e (x^n)).trans h₂),
    congrArg Subtype.val (mul_comm c x),congrArg Subtype.val h₃⟩
end EFiniteCharacterizations
