module

public import EFiniteCharacterizations.Algebra.MatrixCoefficientField
public import Mathlib.Algebra.Azumaya.Matrix
public import Mathlib.LinearAlgebra.FreeModule.Finite.Matrix
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-! # Two-sided operators on the algebra over the coordinate field -/

@[expose] public section

open scoped TensorProduct

namespace EFiniteCharacterizations

variable {B K n ι : Type*} [Ring B] [Field K] [Fintype n] [DecidableEq n] [Nonempty n]
    [Fintype ι] (q : B →+* Matrix n n K) (b : Module.Basis ι K (Matrix n n K))
    (hb : Set.range b ⊆ Set.range q)

local notation "L" => matrixCoefficientField q b
local notation "H" => matrixImageAlgebra q b

/-- The two-sided multiplication operators for a full matrix basis remain
linearly independent over the field generated by the image coordinates. -/
theorem matrixImage_sandwich_independent :
    LinearIndependent L (fun p : ι × ι ↦
      AlgHom.mulLeftRight L H ((matrixImageBasis q b hb p.1) ⊗ₜ[L]
        MulOpposite.op (matrixImageBasis q b hb p.2))) := by
  classical
  let β := matrixImageBasis q b hb
  let Z := Matrix n n K
  let γ := b.tensorProduct (b.map (MulOpposite.opLinearEquiv K))
  let μ := (AlgHom.mulLeftRight K Z).toLinearMap
  have hli := γ.linearIndependent.map' μ
    (LinearMap.ker_eq_bot.mpr (IsAzumaya.matrix K n).bij.1)
  rw [Fintype.linearIndependent_iff] at hli
  refine (Fintype.linearIndependent_iff (R := ↥L) (v := fun p : ι × ι ↦ AlgHom.mulLeftRight L H ((β p.1) ⊗ₜ[L] MulOpposite.op (β p.2)))).2 ?_
  intro g hg p
  have hzero : ∑ j : ι × ι, (g j : K) • (μ (γ j)) = 0 := by
    apply b.ext
    intro i
    have hh : ∑ j : ι × ι, g j • (β j.1 * β i * β j.2) = 0 := by
      simpa [AlgHom.mulLeftRight_apply] using LinearMap.congr_fun hg (β i)
    have hv := congrArg (matrixImageAlgebra q b).val hh
    rw [map_sum, map_zero] at hv
    simpa [μ, γ, β, Z, Module.Basis.tensorProduct_apply', AlgHom.mulLeftRight_apply, Subfield.smul_def] using hv
  exact Subtype.ext (hli (fun j ↦ (g j : K)) hzero p)

/-- Every linear operator on the descended algebra is a linear combination of
left and right multiplication by image basis elements. -/
theorem matrixImage_operator_expansion (f : Module.End L H) :
    ∃ c : ι × ι → L, ∀ x : H, ∑ p, c p •
      (matrixImageBasis q b hb p.1 * x * matrixImageBasis q b hb p.2) = f x := by
  classical
  let β := matrixImageBasis q b hb
  let : Module.Finite L H := Module.Finite.of_basis β
  let op := fun p : ι × ι ↦
    AlgHom.mulLeftRight L H (β p.1 ⊗ₜ[L] MulOpposite.op (β p.2))
  have hcard : Fintype.card (ι × ι) = Module.finrank L (Module.End L H) := by
    rw [Fintype.card_prod, Module.finrank_linearMap, Module.finrank_eq_card_basis β]
  let e := basisOfLinearIndependentOfCardEqFinrank' (K := ↥L) (V := Module.End L H) op
    (matrixImage_sandwich_independent q b hb) hcard
  refine ⟨fun p ↦ e.repr f p, fun x ↦ ?_⟩
  simpa [e, op, β, AlgHom.mulLeftRight_apply] using LinearMap.congr_fun (e.sum_repr f) x

/-- Multipliers with left factors in the matrix image separate the basis vectors. -/
theorem matrixImage_separating_multipliers [DecidableEq ι] (l : ι) :
    ∃ v : ι × ι → H, ∀ i, ∑ p, matrixImageBasis q b hb p.1 *
      matrixImageBasis q b hb i * v p = if i = l then 1 else 0 := by
  let β := matrixImageBasis q b hb
  obtain ⟨c, hc⟩ := matrixImage_operator_expansion q b hb ((β.coord l).smulRight (1 : H))
  refine ⟨fun p ↦ c p • β p.2, fun i ↦ ?_⟩
  simpa [β, mul_smul_comm, Module.Basis.coord_apply, Finsupp.single_apply, eq_comm]
    using hc (β i)

end EFiniteCharacterizations
