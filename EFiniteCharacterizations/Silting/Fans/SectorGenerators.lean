module

public import EFiniteCharacterizations.LinearAlgebra.IntegralConeRelation
public import EFiniteCharacterizations.Presentations.ProjectiveRankBound
public import EFiniteCharacterizations.Presentations.StableAdd

/-! # Additive generators from a finite sector cover -/

@[expose] public section

open CategoryTheory
open scoped TensorProduct

universe u

namespace EFiniteCharacterizations.TwoTerm

variable {R : Type u} [Ring R]

/-- A finite direct sum of identical two-term complexes. -/
noncomputable def copies (P : TwoTerm R) : ℕ → TwoTerm R
  | 0 => contractible (ProjectiveClass.zeroProjective R)
  | n + 1 => P.directSum (copies P n)

@[simp] theorem projectiveClass_copies (P : TwoTerm R) (n : ℕ) :
    (P.copies n).projectiveClass = n • P.projectiveClass := by
  induction n with
  | zero => simp [copies, projectiveClass]
  | succ n ih => simp [copies, ih, add_comm, succ_nsmul]

theorem isInAdd_copies (P : TwoTerm R) (n : ℕ) : IsInAdd (P.copies n).asArrow P.asArrow := by
  induction n with
  | zero =>
    refine ⟨[], ?_⟩
    change (0 : (P.copies 0).asArrow ⟶ (P.copies 0).asArrow) = 𝟙 _
    apply Arrow.hom_ext
    · exact ProjectiveClass.zeroProjective_isZero.eq_of_src _ _
    · exact ProjectiveClass.zeroProjective_isZero.eq_of_src _ _
  | succ n ih => exact isInAdd_directSum P (P.copies n) P.asArrow (.refl _) ih

theorem isInAdd_of_pos_copies (P : TwoTerm R) {n : ℕ} (hn : 0 < n) : IsInAdd P.asArrow (P.copies n).asArrow := by
  cases n with
  | zero => omega
  | succ n => exact IsInAdd.of_retraction _ _ (inlDirectSum_fstDirectSum P (P.copies n))

variable (k : Type u) [Field k] [Algebra k R] [Module.Finite k R]

theorem shiftedHomFinrank_copies_source (P V : TwoTerm R) (n : ℕ) :
    (P.copies n).shiftedHomFinrank k V = n * P.shiftedHomFinrank k V := by
  induction n with
  | zero => simp [copies, shiftedHomFinrank_contractible_source]
  | succ n ih => simp [copies, shiftedHomFinrank_directSum_source, ih, Nat.succ_mul, add_comm]

theorem shiftedHomFinrank_copies_target (P V : TwoTerm R) (n : ℕ) :
    V.shiftedHomFinrank k (P.copies n) = n * V.shiftedHomFinrank k P := by
  induction n with
  | zero => simp [copies, shiftedHomFinrank_contractible_target]
  | succ n ih => simp [copies, shiftedHomFinrank_directSum_target, ih, Nat.succ_mul, add_comm]

include k in
theorem isPresilting_copies {P : TwoTerm R} (hP : P.IsPresilting) (n : ℕ) : (P.copies n).IsPresilting := by
  apply (shiftedHomFinrank_eq_zero_iff k _ _).1
  rw [shiftedHomFinrank_copies_source, shiftedHomFinrank_copies_target,
    (shiftedHomFinrank_eq_zero_iff k P P).2 hP, Nat.mul_zero, Nat.mul_zero]

include k in
/-- A presilting class in the sector of a compatible pair is generated by
that pair up to a contractible summand. -/
theorem isInStableAdd_of_class_mem_sector (P E L : TwoTerm R) (hP : P.IsPresilting)
    (hEL : (E.directSum L).IsPresilting)
    (hsector : realProjectiveClass R P.projectiveClass ∈
      sectorBetween (realProjectiveClass R E.projectiveClass) (realProjectiveClass R L.projectiveClass)) :
    P.IsInStableAdd (E.directSum L) := by
  obtain ⟨a, b, ha, hb, hab⟩ := hsector
  change a • ((1 : ℝ) ⊗ₜ[ℤ] E.projectiveClass) + b • ((1 : ℝ) ⊗ₜ[ℤ] L.projectiveClass) =
    (1 : ℝ) ⊗ₜ[ℤ] P.projectiveClass at hab
  simp only [TensorProduct.smul_tmul', smul_eq_mul, mul_one] at hab
  obtain ⟨m, n, p, hp, hc⟩ := exists_nat_relation_of_real_tensor_relation
    E.projectiveClass L.projectiveClass P.projectiveClass ha hb hab
  let X := P.copies p
  let Y := (E.copies m).directSum (L.copies n)
  have hx : X.IsPresilting := isPresilting_copies k hP p
  obtain ⟨hE, hL, h₁, h₂⟩ := (isPresilting_directSum_iff k E L).1 hEL
  have hy : Y.IsPresilting := by
    apply (isPresilting_directSum_iff k (E.copies m) (L.copies n)).2
    refine ⟨isPresilting_copies k hE m, isPresilting_copies k hL n, ?_, ?_⟩ <;>
      simp only [shiftedHomFinrank_copies_source, shiftedHomFinrank_copies_target, h₁, h₂, Nat.mul_zero]
  have hxy : X.projectiveClass = Y.projectiveClass := by
    simpa only [X, Y, projectiveClass_directSum, projectiveClass_copies] using hc.symm
  obtain ⟨T, hT⟩ := (isInStableAdd_of_isPresilting_of_class_eq k X Y hx hy hxy).1
  let Q := E.directSum L
  let U := Q.directSum (contractible T)
  have hQ : IsInAdd Q.asArrow U.asArrow := IsInAdd.of_retraction _ _ (inlDirectSum_fstDirectSum Q _)
  have hE' : IsInAdd E.asArrow U.asArrow :=
    (IsInAdd.of_retraction _ _ (inlDirectSum_fstDirectSum E L)).trans hQ
  have hL' : IsInAdd L.asArrow U.asArrow :=
    (IsInAdd.of_retraction _ _ (inrDirectSum_sndDirectSum E L)).trans hQ
  have hC : IsInAdd (contractible T).asArrow U.asArrow :=
    IsInAdd.of_retraction _ _ (inrDirectSum_sndDirectSum Q _)
  have hY' : IsInAdd Y.asArrow U.asArrow := isInAdd_directSum _ _ _
    ((isInAdd_copies E m).trans hE') ((isInAdd_copies L n).trans hL')
  have hU : IsInAdd (Y.directSum (contractible T)).asArrow U.asArrow := isInAdd_directSum _ _ _ hY' hC
  exact ⟨T, (isInAdd_of_pos_copies P hp).trans (hT.trans hU)⟩

include k in
/-- With at most two simple classes, an E-finite algebra has a finite list
of presilting complexes whose stable additive closures cover all presilting
complexes. -/
theorem exists_finite_stable_add_generators_of_rank_le_two
    (hr : (simpleIsomorphismClasses R).ncard ≤ 2) (hR : IsEFinite R) :
    ∃ s : List (TwoTerm R), (∀ Q ∈ s, Q.IsPresilting) ∧
      ∀ P : TwoTerm R, P.IsPresilting → ∃ Q ∈ s, P.IsInStableAdd Q := by
  obtain ⟨s, hs, hcover⟩ := exists_presilting_cover_of_simple_rank_le_two k hr hR
  let f (v : TwoTerm R × TwoTerm R) := v.1.directSum v.2
  refine ⟨s.map f, ?_, ?_⟩
  · rintro _ h
    obtain ⟨v, hv, rfl⟩ := List.mem_map.mp h
    exact hs v hv
  · intro P hP
    obtain ⟨v, hv, hsector⟩ := hcover (realProjectiveClass R P.projectiveClass)
    exact ⟨f v, List.mem_map.mpr ⟨v, hv, rfl⟩,
      isInStableAdd_of_class_mem_sector k P v.1 v.2 hP (hs v hv) hsector⟩

end EFiniteCharacterizations.TwoTerm
