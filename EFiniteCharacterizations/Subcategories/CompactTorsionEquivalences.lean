module

public import EFiniteCharacterizations.Subcategories.CompactTorsion
public import EFiniteCharacterizations.Subcategories.TorsionGeneratorPresentation

/-!
# Functorial finiteness of compact torsion classes

Condition `(comp-tors)` of Theorem 3.2 (`thm:core`) and Theorem A(I): over any field,
`R` is E-finite if and only if every singly generated (compact) torsion class `⊥(M⊥)`
in `mod R` is functorially finite (`isEFinite_iff_generatedTorsionClass_functoriallyFinite`),
equivalently if and only if `⊥(B⊥)` is functorially finite for every brick `B`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped ModuleCat.Algebra

universe u

namespace EFiniteCharacterizations

variable (k : Type u) [Field k] {R : Type u} [Ring R] [Algebra k R] [Module.Finite k R]
  [IsNoetherianRing R]

include k in
/-- An integral Euler weight separates the nonzero objects of a functorially
finite torsion class from its right orthogonal. -/
theorem exists_weight_of_functoriallyFinite_leftOrthogonal
    (F : ObjectProperty (FGModuleCat.{u} R)) (h : FunctoriallyFinite (leftHomOrthogonal F)) :
    ∃ θ : Weight (FGModuleCat.{u} R),
      (∀ X, leftHomOrthogonal F X → ¬ IsZero X → 0 < θ.eval X) ∧
      ∀ Y, F Y → θ.eval Y ≤ 0 := by
  obtain ⟨B, a, hB, ha, _, hs⟩ := exists_splitting_torsion_generator k F h
  obtain ⟨p⟩ := MinimalPresentation.nonempty_minimalPresentation k B
  let P := p.twoTerm
  let e := p.cokernelIso
  refine ⟨P.eulerWeight k, fun X hX hn ↦ ?_, fun Y hY ↦ ?_⟩
  · have h₁ := (P.surjective_precompose_iff_no_hom_nakayamaKernel k X).1
        (surjective_precompose_of_splitting_generator p hB hs hX)
    have hz := (homFinrank_eq_zero_iff k X (P.nakayamaKernel k)).2 (fun g ↦ h₁.elim g 0)
    have : Nontrivial (X.obj : Type u) := not_subsingleton_iff_nontrivial.mp
      (hn ∘ (FGModuleCat.isZero_iff_subsingleton X).2)
    obtain ⟨x, hx⟩ := exists_ne (0 : X.obj)
    let f := FGModuleCat.ofHom (LinearMap.toSpanSingleton R X x)
    obtain ⟨g, hg⟩ := ha X hX f
    have hne : e.hom ≫ g ≠ 0 := by
      intro hzero
      have hg₀ : g = 0 := (cancel_epi e.hom).mp (hzero.trans comp_zero.symm)
      have hf : f = 0 := by rw [← hg, hg₀, comp_zero]
      have hv := congrArg (fun b : FGModuleCat.of R R ⟶ X ↦ b.hom.hom 1) hf
      exact hx ((LinearMap.toSpanSingleton_apply_one R _ x).symm.trans hv)
    have hp := (homFinrank_pos_iff k (cokernel P.differential) X).2 ⟨_, hne⟩
    rw [P.eulerWeight_eq_perpendicular_difference k, hz]
    simpa using (Nat.cast_pos (α := ℤ)).2 hp
  · have hz := (homFinrank_eq_zero_iff k (cokernel P.differential) Y).2 (fun g ↦ by
      have hh := hB Y hY (e.inv ≫ g)
      exact (cancel_epi e.inv).mp (hh.trans comp_zero.symm))
    rw [P.eulerWeight_eq_perpendicular_difference k, hz]
    simp

variable [IsArtinianRing R]

include k in
theorem isEFinite_iff_brick_generatedTorsionClass_functoriallyFinite :
    IsEFinite R ↔ ∀ B : FGModuleCat.{u} R, IsBrick B → FunctoriallyFinite (generatedTorsionClass B) := by
  refine ⟨fun h B _ ↦ functoriallyFinite_generatedTorsionClass_of_isEFinite k h B, fun h ↦ ?_⟩
  apply (isEFinite_iff_equalClassBrickHom k).2
  intro X Y hX _ he
  by_contra! hn
  obtain ⟨θ, hpos, hneg⟩ := exists_weight_of_functoriallyFinite_leftOrthogonal k _ (h X hX)
  exact (hpos X (fun _ hZ ↦ hZ) hX.1).not_ge ((congrArg θ he).trans_le (hneg Y hn))

include k in
theorem isEFinite_iff_generatedTorsionClass_functoriallyFinite :
    IsEFinite R ↔ ∀ M : FGModuleCat.{u} R, FunctoriallyFinite (generatedTorsionClass M) :=
  ⟨functoriallyFinite_generatedTorsionClass_of_isEFinite k, fun h ↦
    (isEFinite_iff_brick_generatedTorsionClass_functoriallyFinite k).2 (fun B _ ↦ h B)⟩

/-- The torsion class generated by a set of module isomorphism classes. -/
def torsionClassGeneratedBySet (s : Set (Skeleton (FGModuleCat.{u} R))) :
    ObjectProperty (FGModuleCat.{u} R) :=
  leftHomOrthogonal (fun Y ↦ ∀ x ∈ s, rightHomOrthogonal ((fromSkeleton _).obj x) Y)

include k in
theorem isEFinite_iff_leftFinite_semibricks :
    IsEFinite R ↔ ∀ s : Set (Skeleton (FGModuleCat.{u} R)), IsSemibrick s →
      FunctoriallyFinite (torsionClassGeneratedBySet s) := by
  classical
  constructor
  · intro h s hs
    let _ := ((isEFinite_iff_finite_semibricks k).1 h s hs).fintype
    let A (x : s) := (fromSkeleton (FGModuleCat.{u} R)).obj x.val
    have he : (fun Y ↦ ∀ x ∈ s, rightHomOrthogonal ((fromSkeleton _).obj x) Y) =
        rightHomOrthogonal (⨁ A) := by
      funext Y
      refine propext ⟨fun hx f ↦ ?_, fun hx x hmem f ↦ ?_⟩
      · apply biproduct.hom_ext'
        intro j
        simpa using hx j.val j.property (biproduct.ι A j ≫ f)
      · let j : s := ⟨x, hmem⟩
        simpa using congrArg (biproduct.ι A j ≫ ·) (hx (biproduct.π A j ≫ f))
    rw [torsionClassGeneratedBySet, he]
    exact functoriallyFinite_generatedTorsionClass_of_isEFinite k h _
  · intro h
    apply (isEFinite_iff_brick_generatedTorsionClass_functoriallyFinite k).2
    intro B hb
    let x := toSkeleton B
    let e := fromSkeletonToSkeletonIso B
    have hbrick : IsBrick ((fromSkeleton _).obj x) := by
      refine ⟨fun hz ↦ hb.1 (hz.of_iso e.symm), fun f hf ↦ ?_⟩
      let b := e.inv ≫ f ≫ e.hom
      have he : e.hom ≫ b ≫ e.inv = f := by simp [b]
      have := hb.2 b (fun hz ↦ hf (by simpa [hz] using he.symm))
      rw [← he]
      infer_instance
    have hs : IsSemibrick ({x} : Set _) := ⟨by simpa [brickClasses] using hbrick, by simp⟩
    have he : (fun Y ↦ ∀ y ∈ ({x} : Set _), rightHomOrthogonal ((fromSkeleton _).obj y) Y) =
        rightHomOrthogonal B := by
      funext Y
      simp only [Set.mem_singleton_iff, forall_eq]
      refine propext ⟨fun hh f ↦ (cancel_epi e.hom).mp ((hh _).trans comp_zero.symm),
        fun hh f ↦ (cancel_epi e.inv).mp ((hh _).trans comp_zero.symm)⟩
    simpa only [torsionClassGeneratedBySet, he] using h {x} hs

omit [IsArtinianRing R] in
private theorem functoriallyFinite_perpendicular_of_torsionPair
    {T F : ObjectProperty (FGModuleCat.{u} R)} (hp : IsTorsionPair T F)
    (h : FunctoriallyFinite T) : FunctoriallyFinite (leftHomOrthogonal F) := by
  have liftT {X} (hx : leftHomOrthogonal F X) : ∃ L, T L ∧ Nonempty (L ≅ X) := by
    obtain ⟨L, Y, i, q, w, hL, hY, hs⟩ := hp.2 X
    have := hs.mono_f
    have : Epi i := hs.exact.epi_f_iff.mpr (hx Y hY q)
    have := isIso_of_mono_of_epi i
    exact ⟨L, hL, ⟨asIso i⟩⟩
  constructor
  · intro X
    obtain ⟨L, a, hL, ha⟩ := h.1 X
    refine ⟨L, a, fun _ hy g ↦ hp.1 g hL hy, fun Y hy f ↦ ?_⟩
    obtain ⟨Z, hz, ⟨e⟩⟩ := liftT hy
    obtain ⟨g, hg⟩ := ha Z hz (f ≫ e.inv)
    exact ⟨g ≫ e.hom, by rw [← Category.assoc, hg]; simp⟩
  · intro X
    obtain ⟨L, a, hL, ha⟩ := h.2 X
    refine ⟨L, a, fun _ hy g ↦ hp.1 g hL hy, fun Y hy f ↦ ?_⟩
    obtain ⟨Z, hz, ⟨e⟩⟩ := liftT hy
    obtain ⟨g, hg⟩ := ha Z hz (e.hom ≫ f)
    exact ⟨e.inv ≫ g, by rw [Category.assoc, hg, e.inv_hom_id_assoc]⟩

include k in
theorem isEFinite_iff_torsionRadicalApproximation :
    IsEFinite R ↔ TorsionRadicalApproximation R := by
  refine ⟨torsionRadicalApproximation_of_isEFinite k, fun h ↦ ?_⟩
  apply (isEFinite_iff_numericallyDisjointTorsionPairs k).2
  intro T F hp X Y hX hY hn _ he
  let S := ShortComplex.mk (biprod.inl : X ⟶ X ⊞ Y) biprod.snd biprod.inl_snd
  have hs : S.ShortExact := (ShortComplex.Splitting.ofHasBinaryBiproduct X Y).shortExact
  obtain ⟨T₀, F₀, hp₀, ht, hs₀⟩ := h T F hp 1 (fun _ ↦ S) (fun _ ↦ ⟨hs, hX, hY⟩)
  obtain ⟨θ, hpos, hneg⟩ := exists_weight_of_functoriallyFinite_leftOrthogonal k F₀
    (functoriallyFinite_perpendicular_of_torsionPair hp₀ ht)
  have hx := hpos X (fun _ hz f ↦ hp₀.1 f (hs₀ 0).1 hz) hn
  exact hx.not_ge ((congrArg θ he).trans_le (hneg Y (hs₀ 0).2))

end EFiniteCharacterizations
